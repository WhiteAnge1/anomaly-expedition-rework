local LOOT_EXACT_SPOT = "paw_stash_red"
local ENEMY_EXACT_SPOT = "alife_presentation_squad_enemy_1"
-- Level-map markers flatten world coordinates to X/Z. At this distance two
-- 12 px exact artifact spots are effectively co-located in the tested maps.
-- Keep their truthful object positions and diagnose the overlap; inventing an
-- offset would make an "exact" marker point away from its artifact.
local ARTIFACT_EXACT_OVERLAP_DISTANCE = 2
local callbacks_registered = false
local hooks_installed = false
local next_update = 0
local debug_override = nil
local census_disabled = false
local census_error_reported = false
local next_artifact_diagnostic = 0
local reported_artifact_overlaps = {}
local safe_alive = nil

-- Category selection is a separate weighted roll. Every entry points to an
