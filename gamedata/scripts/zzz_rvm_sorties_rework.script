local function fresh_state()
    return {
        schema = 3,
        level_name = nil,
        sortie_type = nil,
        pending_transition = false,
        transition_from_level = nil,
        start_pos = nil,
        zones = {},
        artifact_zone = {},
        pending_artifacts = {},
        stash_ids = {},
        suppress_stash_calls = 0,
        decoys_created = false,
        last_artifact_time = 0,
        counters = { created = 0, closed = 0, artifact = 0, enemy = 0, loot = 0, empty = 0 },
        census_squads = {},
        census_initialized = false,
    }
end

local state = fresh_state()

local function enabled()
    return C.get_bool("global", "enabled", true)
end

local function debug_enabled()
    if debug_override == "on" then return true end
    if debug_override == "off" then return false end
    local mode = string.lower(C.get_string("global", "debug_mode", ""))
    if mode == "on" then return true end
    if mode == "off" then return false end
    if mode == "auto" then return DEV_DEBUG == true or DEV_DEBUG_DEV == true end
    return C.get_bool("global", "debug_log", false)
end

-- Exact object markers are optional accessibility/casual aids. Full debug
-- always enables them, but their individual user switches do not enable logs,
-- census, technical zone text or any other diagnostic behavior.
local function artifact_exact_marker_enabled()
    return debug_enabled() or C.get_bool("global", "show_exact_artifact_markers", false)
end

local function loot_exact_marker_enabled()
    return debug_enabled() or C.get_bool("global", "show_exact_loot_markers", false)
end

local function enemy_exact_marker_enabled()
    return debug_enabled() or C.get_bool("global", "show_exact_enemy_markers", false)
end

local function log(fmt, ...)
    if debug_enabled() or string.sub(tostring(fmt), 1, 5) == "ERROR" then
        printf(PREFIX .. " " .. fmt, ...)
    end
end

local SUPPORTED_LEVELS = { y04_pole = true, k01_darkscape = true, l09_deadcity = true }

local function release_log(fmt, ...)
    if state and state.level_name and SUPPORTED_LEVELS[state.level_name]
    and (state.sortie_type == "infected" or state.sortie_type == "scouting") then
        printf(PREFIX .. " " .. fmt, ...)
    end
end

local function pos_table(pos)
    return pos and { x = pos.x, y = pos.y, z = pos.z } or nil
end

local function pos_vector(pos)
    return pos and vector():set(pos.x, pos.y, pos.z) or nil
end

local function distance_xz(a, b)
    if not (a and b) then return 999999 end
    local dx = a.x - b.x
    local dz = a.z - b.z
    return math.sqrt(dx * dx + dz * dz)
end

local function fmt_number(value)
    value = tonumber(value) or 0
    return tostring(math.floor(value * 10 + 0.5) / 10)
end

local function valid_vertex(pos)
    if not (level and pos) then return nil end
    local lvid = level.vertex_id(pos)
    if not lvid or lvid >= 4294967295 then return nil end
    return lvid
end

local function current_tier()
    local forced = math.floor(C.get_number("global", "debug_force_tier", 0))
    if forced >= 1 and forced <= 3 then return forced end
    return C.get_level_tier(level.name())
end

local function balanced(key, default)
    local forced = math.floor(C.get_number("global", "debug_force_tier", 0))
    if forced >= 1 and forced <= 3 then
        return C.get_number("tier_" .. tostring(forced), key, C.get_number("global", key, default))
    end
    return C.get_balanced(level.name(), key, default)
end

local function balanced_list(key)
    local forced = math.floor(C.get_number("global", "debug_force_tier", 0))
    if forced >= 1 and forced <= 3 then return C.get_list("tier_" .. tostring(forced), key) end
    return C.get_balanced_list(level.name(), key)
end

local function balanced_string(key, default)
    local forced = math.floor(C.get_number("global", "debug_force_tier", 0))
    if forced >= 1 and forced <= 3 then
        return C.get_string("tier_" .. tostring(forced), key, C.get_string("global", key, default))
    end
    return C.get_balanced_string(level.name(), key, default)
end

local function spot_for_level()
    local forced = math.floor(C.get_number("global", "debug_force_tier", 0))
    if forced >= 1 and forced <= 3 then
        return C.get_string("tier_" .. tostring(forced), "map_spot", "rvm_search_small")
    end
    return C.get_balanced_string(level.name(), "map_spot", "rvm_search_small")
end

local function safe_release(id)
    if not id then return end
    local found, obj = pcall(alife_object, id)
    if found and obj then
        local released, err = pcall(alife_release, obj)
        if not released then log("ERROR release id=%s error=%s", tostring(id), tostring(err)) end
    end
end

local function object_section(obj)
    if not obj then return nil end
    local ok, section = pcall(function() return obj:section_name() end)
    if ok and section then return section end
    ok, section = pcall(function() return obj:section() end)
    return ok and section or nil
end

local function section_name(section)
    if not section then return "unknown" end
    local token = ini_sys:section_exist(section) and ini_sys:r_string_ex(section, "inv_name")
    if not token then return section end
    local translated = game.translate_string(token)
    return translated and translated ~= "" and translated or section
end

local function join_values(values, separator)
    local result = ""
    for index, value in ipairs(values or {}) do
        if index > 1 then result = result .. (separator or ", ") end
        result = result .. tostring(value)
    end
    return result
end

local function safe_object_id_any(obj)
    if not obj then return nil end
    local ok, id = pcall(function() return obj.id end)
    if ok and type(id) == "number" then return id end
    ok, id = pcall(function() return obj:id() end)
    return ok and type(id) == "number" and id or nil
end

local function split_csv(value)
    local result = {}
    for token in string.gmatch(tostring(value or ""), "[^,]+") do
        token = string.gsub(token, "^%s+", "")
        token = string.gsub(token, "%s+$", "")
        if token ~= "" then result[#result + 1] = token end
    end
    return result
end

local function sorted_copy(values)
    local result = {}
    for _, value in ipairs(values or {}) do result[#result + 1] = tostring(value) end
    table.sort(result)
    return result
end

local function same_members(expected, actual)
    local left, right = sorted_copy(expected), sorted_copy(actual)
    if #left ~= #right then return false end
    for index = 1, #left do
        if left[index] ~= right[index] then return false end
    end
    return true
end

local function preset_members(section)
    if not (section and ini_sys and ini_sys:section_exist(section)) then return nil, "missing_section" end
    local ok, value = pcall(function() return ini_sys:r_string_ex(section, "npc") end)
    if not (ok and value) then return nil, "missing_fixed_npc" end
    local members = split_csv(value)
    if #members == 0 then return nil, "empty_fixed_npc" end
    local random_ok, random_value = pcall(function() return ini_sys:r_string_ex(section, "npc_random") end)
    if random_ok and random_value and tostring(random_value) ~= "" then return nil, "npc_random_forbidden" end
    local count_ok, count = pcall(function() return ini_sys:r_u32(section, "npc_in_squad") end)
    if not count_ok or tonumber(count) ~= #members then return nil, "npc_in_squad_mismatch" end
    return members, nil
end

local function enumerate_squad_members(squad)
    local ids, sections, objects = {}, {}, {}
    local ok, err = pcall(function()
        for member in squad:squad_members() do
            local id = safe_object_id_any(member)
            local server = nil
            local object_ok, object_value = pcall(function() return member.object end)
            if object_ok then server = object_value end
            if not server and id then
                local resolve_ok, resolved = pcall(alife_object, id)
                if resolve_ok then server = resolved end
            end
            id = id or safe_object_id_any(server)
            if not (id and server) then error("unresolved_squad_member") end
            ids[#ids + 1] = id
            sections[#sections + 1] = object_section(server) or "unknown"
            objects[#objects + 1] = server
        end
    end)
    if not ok then return nil, nil, nil, tostring(err) end
    return ids, sections, objects, nil
end

local function squad_commander_id(squad)
    if not squad then return nil end
    local ok, id = pcall(function() return squad:commander_id() end)
    return ok and type(id) == "number" and id or nil
end

local function release_enemy_squad(zone, reason)
    if not zone then return end
    local released = false
    local squad = zone._squad_object
    if zone.squad_id then
        local found, value = pcall(alife_object, zone.squad_id)
        if found and value then squad = value end
    end
    if squad then
        local ok, err = pcall(alife_release, squad)
        released = ok
        if not ok then
            log("ERROR squad release squad_id=%s preset=%s reason=%s error=%s; orphan fallback follows",
                tostring(zone.squad_id), tostring(zone.squad_section), tostring(reason), tostring(err))
        end
    end
    if not released then
        for id, _ in pairs(zone.member_ids or zone.spawned_ids or {}) do safe_release(id) end
    end
    log("ambush squad cleanup squad_id=%s preset=%s reason=%s released_as_group=%s",
        tostring(zone.squad_id), tostring(zone.squad_section), tostring(reason), tostring(released))
    zone.squad_id = nil
end

local function choose_enemy_preset(zone)
    if zone.squad_section and zone.squad_category then return zone.squad_category, zone.squad_section end
    local level_presets = ENEMY_SQUAD_PRESETS[level.name()]
    if not level_presets then return nil, nil, "unsupported_level" end
    local weights = {
        frequent = math.max(0, balanced("enemy_category_weight_frequent", 4)),
        rare = math.max(0, balanced("enemy_category_weight_rare", 2)),
        superrare = math.max(0, balanced("enemy_category_weight_superrare", 1)),
    }
    local total = weights.frequent + weights.rare + weights.superrare
    if total <= 0 then return nil, nil, "all_category_weights_zero" end
    local roll = math.random() * total
    local category = roll < weights.frequent and "frequent"
        or roll < weights.frequent + weights.rare and "rare" or "superrare"
    local presets = level_presets[category] or {}
    if #presets == 0 then return nil, nil, "empty_category_" .. tostring(category) end
    local preset = presets[math.random(1, #presets)]
    zone.squad_category = category
    zone.squad_section = preset
    log("ambush preset selected tier=%s level=%s category=%s weights=%s:%s:%s normalized=%s/%s/%s preset=%s category_size=%s",
        tostring(current_tier()), tostring(level.name()), tostring(category), tostring(weights.frequent), tostring(weights.rare),
        tostring(weights.superrare), fmt_number(weights.frequent * 100 / total), fmt_number(weights.rare * 100 / total),
        fmt_number(weights.superrare * 100 / total), tostring(preset), tostring(#presets))
    return category, preset, nil
end

local function spawn_exact_squad(zone, pos, lvid, cascade_step)
    local expected, preset_error = preset_members(zone.squad_section)
    if not expected then return false, "preset_" .. tostring(preset_error) end
    local create_ok, squad = pcall(alife_create, zone.squad_section, pos, lvid, db.actor:game_vertex_id())
    if not (create_ok and squad) then return false, "group_create_failed:" .. tostring(squad) end

    local temporary = { squad_id = safe_object_id_any(squad), squad_section = zone.squad_section, member_ids = {}, _squad_object = squad }
    local populate_ok, populate_error = pcall(function() squad:create_npc(nil, pos, lvid, db.actor:game_vertex_id()) end)
    local ids, sections, objects, enumerate_error = enumerate_squad_members(squad)
    if ids then for _, id in ipairs(ids) do temporary.member_ids[id] = true end end
    if not populate_ok or enumerate_error or not same_members(expected, sections) then
        local reason = not populate_ok and ("create_npc_failed:" .. tostring(populate_error))
            or enumerate_error and ("enumerate_failed:" .. tostring(enumerate_error))
            or ("composition_mismatch expected=" .. join_values(sorted_copy(expected), ",")
                .. " actual=" .. join_values(sorted_copy(sections), ","))
        release_enemy_squad(temporary, "partial_spawn_rollback")
        return false, reason
    end

    local setup_ok, setup_error = pcall(function()
        for _, member in ipairs(objects) do
            SIMBOARD:setup_squad_and_group(member)
            SendScriptCallback("squad_on_npc_creation", squad, member)
        end
    end)
    if not setup_ok then
        release_enemy_squad(temporary, "callback_rollback")
        return false, "setup_or_callback_failed:" .. tostring(setup_error)
    end

    zone.squad_id = temporary.squad_id
    zone.member_ids = temporary.member_ids
    zone.spawned_ids = temporary.member_ids
    zone.spawned_info = {}
    local members_log = {}
    for index, id in ipairs(ids) do
        zone.spawned_info[id] = { section = sections[index], pos = pos_table(pos), resolved = false }
        members_log[#members_log + 1] = tostring(sections[index]) .. "#" .. tostring(id)
    end
    log("ambush squad created tier=%s category=%s preset=%s squad_id=%s cascade=%s members=[%s] owned_by_rework=true",
        tostring(current_tier()), tostring(zone.squad_category), tostring(zone.squad_section), tostring(zone.squad_id),
        tostring(cascade_step), join_values(members_log, ";"))
    return true, nil
end

local function safe_parent_id(obj)
    if not obj then return nil end
    local ok, id = pcall(function() return obj.parent_id end)
    return ok and type(id) == "number" and id or nil
end

local function safe_object_position(obj)
    if not obj then return nil end
    local ok, pos = pcall(function()
        local value = obj.position
        if type(value) == "function" or not value then return nil end
        return pos_table(value)
    end)
    if ok and pos then return pos end
    ok, pos = pcall(function() return pos_table(obj:position()) end)
    return ok and pos or nil
end

local function fmt_position(pos)
    if not pos then return "none" end
    return fmt_number(pos.x) .. "," .. fmt_number(pos.y) .. "," .. fmt_number(pos.z)
end

-- The item-take callback is not guaranteed for corpse loot/trade. The exact
-- server ID is therefore also checked against actor inventory and its parent
-- chain. Every engine-facing access is protected: an uncertain result keeps
-- the zone open instead of risking a false close or an X-Ray crash.
local function artifact_snapshot(zone)
    local id = zone and zone.artifact_id
    local snapshot = {
        id = id,
        server_exists = false,
        online_exists = false,
        actor_inventory = false,
        actor_owned = false,
        ownership_source = "none",
        parent_id = nil,
        parent_chain = {},
    }
    if not (id and db.actor) then return snapshot end

    local actor_id = safe_object_id_any(db.actor)
    local server_ok, server_obj = pcall(alife_object, id)
    if server_ok and server_obj then
        snapshot.server_exists = true
        snapshot.server_pos = safe_object_position(server_obj)
        snapshot.parent_id = safe_parent_id(server_obj)
    end
    local online_ok, online_obj = pcall(function() return level and level.object_by_id(id) end)
    if online_ok and online_obj then
        snapshot.online_exists = true
        snapshot.online_pos = safe_object_position(online_obj)
        local parent_ok, parent = pcall(function() return online_obj:parent() end)
        snapshot.online_parent_id = parent_ok and safe_object_id_any(parent) or nil
    end

    local inventory_ok, inventory_err = pcall(function()
        db.actor:iterate_inventory(function(_, item)
            if safe_object_id_any(item) == id then snapshot.actor_inventory = true end
        end, nil)
    end)
    snapshot.inventory_check = inventory_ok and "ok" or ("error:" .. tostring(inventory_err))
    if snapshot.actor_inventory then
        snapshot.actor_owned = true
        snapshot.ownership_source = "actor_inventory"
    elseif actor_id ~= nil and snapshot.online_parent_id == actor_id then
        snapshot.actor_owned = true
        snapshot.ownership_source = "online_parent"
    end

    local parent_id = snapshot.parent_id
    local visited = {}
    for _ = 1, 8 do
        if parent_id == nil or parent_id == 65535 or visited[parent_id] then break end
        snapshot.parent_chain[#snapshot.parent_chain + 1] = parent_id
        if actor_id ~= nil and parent_id == actor_id then
            snapshot.actor_owned = true
            if snapshot.ownership_source == "none" then snapshot.ownership_source = "server_parent_chain" end
            break
        end
        visited[parent_id] = true
        local parent_ok, parent_obj = pcall(alife_object, parent_id)
        if not (parent_ok and parent_obj) then break end
        parent_id = safe_parent_id(parent_obj)
    end

    local pos = snapshot.online_pos or snapshot.server_pos
    if pos then
        snapshot.anchor_distance = zone.center and distance_xz(pos, zone.center) or nil
        snapshot.anchor_delta_y = zone.center and (pos.y - zone.center.y) or nil
        local vertex_ok, lvid = pcall(valid_vertex, pos_vector(pos))
        if vertex_ok and lvid then
            snapshot.nearest_vertex = lvid
            local nearest_ok, nearest = pcall(level.vertex_position, lvid)
            if nearest_ok and nearest then
                snapshot.vertex_distance = distance_xz(pos, nearest)
                snapshot.vertex_delta_y = pos.y - nearest.y
            end
        end
    end
    return snapshot
end

local function artifact_diagnostic_text(snapshot)
    if not snapshot then return "snapshot=unavailable" end
    return "exists(server=" .. tostring(snapshot.server_exists)
        .. ",online=" .. tostring(snapshot.online_exists) .. ")"
        .. " parent=" .. tostring(snapshot.parent_id)
        .. " online_parent=" .. tostring(snapshot.online_parent_id)
        .. " chain=" .. join_values(snapshot.parent_chain, ">")
        .. " actor_inventory=" .. tostring(snapshot.actor_inventory)
        .. " inventory_check=" .. tostring(snapshot.inventory_check)
        .. " owned=" .. tostring(snapshot.actor_owned)
        .. " source=" .. tostring(snapshot.ownership_source)
        .. " server_pos=" .. fmt_position(snapshot.server_pos)
        .. " online_pos=" .. fmt_position(snapshot.online_pos)
        .. " anchor_dxz=" .. fmt_number(snapshot.anchor_distance or -1)
        .. " anchor_dy=" .. fmt_number(snapshot.anchor_delta_y or -9999)
        .. " vertex=" .. tostring(snapshot.nearest_vertex)
        .. " vertex_dxz=" .. fmt_number(snapshot.vertex_distance or -1)
        .. " vertex_dy=" .. fmt_number(snapshot.vertex_delta_y or -9999)
end

local function zone_debug_text(zone, exact_target)
    if not debug_enabled() then return "" end
    local linked = zone.artifact_id or zone.content_id or "none"
    local lines = {
        "[RVM REWORK DEBUG] kind=" .. tostring(zone.kind)
            .. " anchor=" .. tostring(zone.anchor_id)
            .. " radius=" .. fmt_number(zone.radius)
            .. " linked=" .. tostring(linked),
    }
    if zone.kind == "artifact" then
        lines[#lines + 1] = "artifact_id=" .. tostring(zone.artifact_id)
            .. " section=" .. tostring(zone.artifact_section)
            .. " name=" .. tostring(zone.artifact_name)
    elseif zone.kind == "loot" then
        local pos = zone.visual_pos or zone.center
        local distance = db.actor and pos and distance_xz(db.actor:position(), pos) or -1
        lines[#lines + 1] = "visual_id=" .. tostring(zone.visual_id)
            .. " box_id=" .. tostring(zone.content_id)
            .. " distance=" .. fmt_number(distance)
        if pos then
            lines[#lines + 1] = "position=" .. fmt_number(pos.x) .. "," .. fmt_number(pos.y) .. "," .. fmt_number(pos.z)
        end
        lines[#lines + 1] = "contents=" .. join_values(zone.loot_sections, ",")
        if exact_target then lines[#lines + 1] = "EXACT LOOT TARGET" end
    elseif zone.kind == "enemy" then
        if not zone.triggered then
            lines[#lines + 1] = "state=armed"
        else
            local spawned = {}
            for id, info in pairs(zone.spawned_info or {}) do
                spawned[#spawned + 1] = tostring(info.section) .. "#" .. tostring(id)
            end
            table.sort(spawned)
            lines[#lines + 1] = "state=spawned entities=" .. join_values(spawned, ",")
        end
    else
        lines[#lines + 1] = "state=empty"
    end
    return "\n" .. join_values(lines, "\n")
end

local function safe_remove_map_spot(id, spot)
    if not (level and id and spot) then return end
    local ok, present = pcall(level.map_has_object_spot, id, spot)
    if not ok or present == 0 then return end
    pcall(level.map_remove_object_spot, id, spot)
    pcall(level.map_remove_object_spot, id, spot)
end

local function safe_add_map_spot(id, spot, hint)
    if not (level and id and spot) then return false end
    local ok, present = pcall(level.map_has_object_spot, id, spot)
    if not ok then return false end
    if present ~= 0 then return true end
    ok = pcall(level.map_add_object_spot_ser, id, spot, hint or "")
    return ok
end

local function artifact_exact_debug_text(zone, snapshot)
    local pos = snapshot and (snapshot.online_pos or snapshot.server_pos) or nil
    local parent = snapshot and (snapshot.online_parent_id or snapshot.parent_id) or nil
    return "[RVM DEBUG] kind=artifact"
        .. " artifact_id=" .. tostring(zone.artifact_id)
        .. " section=" .. tostring(zone.artifact_section)
        .. " name=" .. tostring(zone.artifact_name)
        .. "\nposition=" .. fmt_position(pos)
        .. " parent=" .. tostring(parent)
end

local function enemy_exact_debug_text(id, info, alive, alive_source)
    return "[RVM DEBUG] kind=enemy"
        .. " section=" .. tostring(info and info.section or "unknown")
        .. " id=" .. tostring(id)
        .. " owned_by_rework=true"
        .. " alive=" .. tostring(alive)
        .. " alive_source=" .. tostring(alive_source)
end

local function exact_marker_hint(string_id, debug_text)
    if debug_enabled() then return debug_text end
    return game.translate_string(string_id)
end

local function sync_artifact_exact_spot(zone, snapshot, force_refresh)
    if not (zone and zone.artifact_id) then return end
    if artifact_exact_marker_enabled() and snapshot and snapshot.server_exists then
        local parent = snapshot.online_parent_id or snapshot.parent_id
        local signature = tostring(parent) .. ":" .. tostring(debug_enabled())
        if force_refresh or zone.artifact_exact_signature ~= signature then
            safe_remove_map_spot(zone.artifact_id, ARTIFACT_EXACT_SPOT)
        end
        local hint = exact_marker_hint("st_rvm_sorties_exact_artifact_hint", artifact_exact_debug_text(zone, snapshot))
        safe_add_map_spot(zone.artifact_id, ARTIFACT_EXACT_SPOT, hint)
        zone.artifact_exact_signature = signature
    else
        safe_remove_map_spot(zone.artifact_id, ARTIFACT_EXACT_SPOT)
        zone.artifact_exact_signature = nil
    end
end

local function diagnose_artifact_exact_overlaps(candidates)
    if not debug_enabled() then return end
    for left = 1, #candidates - 1 do
        for right = left + 1, #candidates do
            local a = candidates[left]
            local b = candidates[right]
            local map_distance = distance_xz(a.pos, b.pos)
            if map_distance <= ARTIFACT_EXACT_OVERLAP_DISTANCE then
                local low = math.min(a.id, b.id)
                local high = math.max(a.id, b.id)
                local key = tostring(low) .. ":" .. tostring(high)
                if not reported_artifact_overlaps[key] then
                    reported_artifact_overlaps[key] = true
                    log("exact artifact marker overlap ids=%s,%s sections=%s,%s map_dxz=%s threshold=%s positions=(%s)/(%s); exact positions preserved",
                        tostring(a.id), tostring(b.id), tostring(a.section), tostring(b.section),
                        fmt_number(map_distance), tostring(ARTIFACT_EXACT_OVERLAP_DISTANCE),
                        fmt_position(a.pos), fmt_position(b.pos))
                end
            end
        end
    end
end

local function sync_enemy_exact_spot(id, info, alive, alive_source)
    if enemy_exact_marker_enabled() and alive == true then
        local hint = exact_marker_hint("st_rvm_sorties_exact_enemy_hint", enemy_exact_debug_text(id, info, alive, alive_source))
        safe_add_map_spot(id, ENEMY_EXACT_SPOT, hint)
    else
        safe_remove_map_spot(id, ENEMY_EXACT_SPOT)
    end
end

local function sync_enemy_squad_exact_spot(zone)
    if not (zone and zone.kind == "enemy") then return end
    if not zone.squad_id then
        -- Compatibility with schema 2 alpha saves that contained independent
        -- entities. Newly created zones always take the commander-only path.
        for id, _ in pairs(zone.spawned_ids or {}) do
            local ok, obj = pcall(alife_object, id)
            obj = ok and obj or nil
            local alive, alive_source = safe_alive(id, obj)
            sync_enemy_exact_spot(id, zone.spawned_info and zone.spawned_info[id], alive, alive_source)
        end
        return
    end
    local squad = nil
    if zone.squad_id then
        local ok, value = pcall(alife_object, zone.squad_id)
        if ok then squad = value end
    end
    local commander_id = squad_commander_id(squad)
    local commander = nil
    if commander_id then
        local ok, value = pcall(alife_object, commander_id)
        if ok then commander = value end
    end
    local alive, alive_source = safe_alive(commander_id, commander)
    if not enemy_exact_marker_enabled() or alive ~= true then commander_id = nil end

    if zone.marker_target_id and zone.marker_target_id ~= commander_id then
        safe_remove_map_spot(zone.marker_target_id, ENEMY_EXACT_SPOT)
        log("ambush marker detached squad_id=%s old_commander=%s new_commander=%s",
            tostring(zone.squad_id), tostring(zone.marker_target_id), tostring(commander_id))
        zone.marker_target_id = nil
    end
    if commander_id then
        local info = zone.spawned_info and zone.spawned_info[commander_id]
        sync_enemy_exact_spot(commander_id, info, alive, alive_source)
        if zone.marker_target_id ~= commander_id then
            log("ambush marker attached squad_id=%s commander_id=%s section=%s",
                tostring(zone.squad_id), tostring(commander_id), tostring(info and info.section or object_section(commander)))
        end
        zone.marker_target_id = commander_id
    end
end

local function remove_spot(zone)
    if not zone then return end
    safe_remove_map_spot(zone.anchor_id, zone.spot)
    safe_remove_map_spot(zone.artifact_id, ARTIFACT_EXACT_SPOT)
    zone.artifact_exact_signature = nil
    safe_remove_map_spot(zone.visual_id, LOOT_EXACT_SPOT)
    safe_remove_map_spot(zone.marker_target_id, ENEMY_EXACT_SPOT)
    zone.marker_target_id = nil
    for id, _ in pairs(zone.spawned_ids or {}) do
        safe_remove_map_spot(id, ENEMY_EXACT_SPOT)
    end
    -- Remove the pre-0.2.1-alpha debug dot when loading an older test save.
    safe_remove_map_spot(zone.visual_id, "rvm_debug_target")
end

local function add_zone_spots(zone)
    if not (zone and not zone.closed and zone.anchor_id and alife_object(zone.anchor_id)) then return end
    local hint = game.translate_string("st_rvm_sorties_area_hint") .. zone_debug_text(zone, false)
    level.map_add_object_spot_ser(zone.anchor_id, zone.spot, hint)
    if artifact_exact_marker_enabled() and zone.kind == "artifact" and zone.artifact_id then
        local ok, snapshot = pcall(artifact_snapshot, zone)
        if ok then sync_artifact_exact_spot(zone, snapshot, true) end
    elseif loot_exact_marker_enabled() and zone.kind == "loot" and zone.visual_id and alife_object(zone.visual_id) then
        local debug_hint = game.translate_string("st_rvm_sorties_area_hint") .. zone_debug_text(zone, true)
        local exact_hint = exact_marker_hint("st_rvm_sorties_exact_loot_hint", debug_hint)
        safe_add_map_spot(zone.visual_id, LOOT_EXACT_SPOT, exact_hint)
    elseif enemy_exact_marker_enabled() and zone.kind == "enemy" and zone.triggered then
        sync_enemy_squad_exact_spot(zone)
    end
end

local function refresh_zone_spots(zone)
    remove_spot(zone)
    add_zone_spots(zone)
end

local function refresh_all_zone_spots()
    for _, zone in pairs(state.zones or {}) do
        if not zone.closed then refresh_zone_spots(zone) end
    end
end

local function release_anchor(zone)
    if not (zone and zone.anchor_id) then return end
    if zone.paw_anchor and tasks_placeable_waypoints and tasks_placeable_waypoints.deregister_script_zone then
        local ok, result = pcall(tasks_placeable_waypoints.deregister_script_zone, zone.anchor_id)
        if ok and result ~= false then return end
    end
    if zone.managed_anchor and raid_objects_arranger and raid_objects_arranger.release_raid_objects then
        local ok = pcall(raid_objects_arranger.release_raid_objects, zone.anchor_id)
        if not ok then safe_release(zone.anchor_id) end
    else
        safe_release(zone.anchor_id)
    end
end

local function release_loot(zone)
    if zone.content_id then safe_release(zone.content_id) end
    if zone.visual_id then
        if zone.managed_visual and raid_objects_arranger and raid_objects_arranger.release_raid_objects then
            local ok = pcall(raid_objects_arranger.release_raid_objects, zone.visual_id)
            if not ok then safe_release(zone.visual_id) end
        else
            safe_release(zone.visual_id)
        end
    end
end

local function close_zone(zone, reason)
    if not zone or zone.closed then return end
    remove_spot(zone)
    -- Releasing an inventory box inside its use callback can invalidate the
    -- inventory window. Keep an opened box until sortie cleanup.
    if reason ~= "container_opened" then release_loot(zone) end
    release_anchor(zone)
    zone.closed = true
    state.counters.closed = (state.counters.closed or 0) + 1
    release_log("zone closed type=%s reason=%s progress=%s/%s",
        tostring(zone.kind), tostring(reason), tostring(state.counters.closed), tostring(state.counters.created))
    log("close type=%s anchor=%s reason=%s closed=%s/%s",
        tostring(zone.kind), tostring(zone.anchor_id), tostring(reason),
        tostring(state.counters.closed), tostring(state.counters.created))
end

local function cleanup_stashes()
    for id, _ in pairs(state.stash_ids or {}) do
        safe_remove_map_spot(id, "secondary_task_location")
        if raid_tasks_main and raid_tasks_main.raid_busy_stashes_t then
            raid_tasks_main.raid_busy_stashes_t[id] = nil
        end
        if grok_stashes_on_corpses and grok_stashes_on_corpses.clear_stash then
            pcall(grok_stashes_on_corpses.clear_stash, id, state.level_name)
        end
    end
end

function cleanup(reason)
    release_log("cleanup reason=%s zones=%s closed=%s artifact=%s enemy=%s loot=%s empty=%s",
        tostring(reason), tostring(size_table(state.zones or {})), tostring(state.counters.closed or 0),
        tostring(state.counters.artifact or 0), tostring(state.counters.enemy or 0),
        tostring(state.counters.loot or 0), tostring(state.counters.empty or 0))
    log("cleanup reason=%s level=%s zones=%s", tostring(reason), tostring(state.level_name), tostring(size_table(state.zones or {})))
    for _, zone in pairs(state.zones or {}) do
        remove_spot(zone)
        if zone.squad_id then
            release_enemy_squad(zone, reason)
        elseif zone.spawned_ids then
            -- Schema 2 saves used independent entities. Keep a narrow legacy
            -- fallback so old alpha saves remain removable after this update.
            for id, _ in pairs(zone.spawned_ids) do safe_release(id) end
        end
        release_loot(zone)
        release_anchor(zone)
    end
    cleanup_stashes()
    state = fresh_state()
    reported_artifact_overlaps = {}
end

local function create_anchor(pos)
    local lvid = valid_vertex(pos)
    if not lvid or not db.actor then return nil end
    local fixed = level.vertex_position(lvid)
    if tasks_placeable_waypoints and tasks_placeable_waypoints.generate_scripted_mapspot_at
    and tasks_placeable_waypoints.set_pingspot_persistence then
        local ok, id = pcall(tasks_placeable_waypoints.generate_scripted_mapspot_at, fixed, lvid, db.actor:game_vertex_id())
        if ok and id then
            tasks_placeable_waypoints.set_pingspot_persistence(id, true)
            return id, pos_table(fixed), true
        end
    end
    local anchor = alife_create("script_zone", fixed, lvid, db.actor:game_vertex_id())
    if not anchor then return nil end
    return anchor.id, pos_table(fixed), false
end

local function separated(pos)
    local minimum = balanced("zone_separation_min", 45)
    for _, zone in pairs(state.zones) do
        if zone.center and distance_xz(pos, zone.center) < minimum then return false end
    end
    return true
end

local function add_zone(kind, anchor_id, center, radius, extra)
    if not (anchor_id and center) then return nil end
    local zone = extra or {}
    zone.kind = kind
    zone.anchor_id = anchor_id
    zone.center = center
    zone.radius = radius
    zone.spot = spot_for_level()
    zone.closed = false
    state.zones[tostring(anchor_id)] = zone
    state.counters.created = state.counters.created + 1
    state.counters[kind] = (state.counters[kind] or 0) + 1
    add_zone_spots(zone)
    release_log("zone created type=%s total=%s", tostring(kind), tostring(state.counters.created))
    log("create type=%s center=(%s, %s, %s) radius=%s anchor=%s linked=%s",
        kind, fmt_number(center.x), fmt_number(center.y), fmt_number(center.z), fmt_number(radius), tostring(anchor_id),
        tostring(zone.artifact_id or zone.content_id or "none"))
    return zone
end

local function random_radius()
    local min_r = math.floor(balanced("zone_radius_min", 80))
    local max_r = math.floor(balanced("zone_radius_max", 140))
    if max_r < min_r then max_r = min_r end
    return math.random(min_r, max_r)
end

local function create_artifact_zone(artifact_id)
    if state.artifact_zone[tostring(artifact_id)] then return true end
    local art = alife_object(artifact_id)
    if not art then
        log("artifact id=%s vanished before area creation", tostring(artifact_id))
        return false
    end
    local radius = random_radius()
    local fmin = C.get_number("global", "artifact_offset_fraction_min", 0.35)
    local fmax = C.get_number("global", "artifact_offset_fraction_max", 0.80)
    local attempts = math.floor(C.get_number("global", "placement_attempts", 60))
    for _ = 1, attempts do
        local angle = math.random() * math.pi * 2
        local offset = radius * (fmin + math.random() * (fmax - fmin))
        local candidate = vector():set(art.position.x + math.cos(angle) * offset, art.position.y, art.position.z + math.sin(angle) * offset)
        local lvid = valid_vertex(candidate)
        if lvid and separated(candidate) then
            local anchor_id, center, paw_anchor = create_anchor(level.vertex_position(lvid))
            local section = object_section(art)
            local zone = add_zone("artifact", anchor_id, center, radius, {
                artifact_id = artifact_id,
                artifact_section = section,
                artifact_name = section_name(section),
                paw_anchor = paw_anchor,
            })
            if zone then
                state.artifact_zone[tostring(artifact_id)] = tostring(anchor_id)
                return true
            end
        end
    end
    log("ERROR no valid center for raid artifact id=%s", tostring(artifact_id))
    return false
end

local function random_decoy_anchor(kind, radius)
    local attempts = math.floor(C.get_number("global", "placement_attempts", 60))
    local timing = kind == "enemy" and string.lower(balanced_string("ambush_spawn_timing", "proximity")) or "none"
    local stages = { { name = "default", minimum = 0 } }
    if kind == "enemy" and state.start_pos then
        if timing == "start" then
            stages = {
                { name = "start_center_preferred", minimum = balanced("ambush_start_center_exclusion_radius", 120) },
                { name = "start_center_relaxed", minimum = math.max(0, balanced("enemy_spawn_distance_min", 80)) },
            }
        else
            local armed_distance = (radius or 0) + balanced("ambush_trigger_padding", 130)
                + balanced("ambush_start_trigger_margin", 20)
            stages = { { name = "proximity_center", minimum = math.max(balanced("ambush_start_exclusion_radius", 180), armed_distance) } }
        end
    end
    for stage_index, stage in ipairs(stages) do
        local rejected_separation, rejected_start = 0, 0
        for _ = 1, attempts do
            local id = raid_objects_arranger.spawn_object_rand_point("raid_shelter_gag", level.name(), -1)
            local obj = id and alife_object(id)
            if obj then
                local valid = separated(obj.position)
                if not valid then rejected_separation = rejected_separation + 1 end
                if valid and state.start_pos and stage.minimum > 0 and distance_xz(obj.position, state.start_pos) < stage.minimum then
                    valid = false
                    rejected_start = rejected_start + 1
                end
                if valid then
                    local position = pos_table(obj.position)
                    raid_objects_arranger.release_raid_objects(id)
                    local anchor_id, center, paw_anchor = create_anchor(pos_vector(position))
                    if anchor_id then
                        log("decoy center success kind=%s stage=%s/%s name=%s minimum_start=%s center=(%s)",
                            tostring(kind), tostring(stage_index), tostring(#stages), tostring(stage.name), fmt_number(stage.minimum), fmt_position(center))
                        return anchor_id, center, paw_anchor, stage.name
                    end
                end
                if alife_object(id) then raid_objects_arranger.release_raid_objects(id) end
            end
        end
        log("decoy center exhausted kind=%s stage=%s/%s name=%s attempts=%s reject=separation:%s,start:%s",
            tostring(kind), tostring(stage_index), tostring(#stages), tostring(stage.name), tostring(attempts),
            tostring(rejected_separation), tostring(rejected_start))
    end
    return nil, nil, nil, "all_center_stages_exhausted"
end

local function valid_sections(list)
    local result = {}
    for _, section in ipairs(list or {}) do
        if ini_sys:section_exist(section) then result[#result + 1] = section
        else log("config section missing, ignored: %s", tostring(section)) end
    end
    return result
end

local function choose_distinct(pool, used)
    local available = {}
    for _, section in ipairs(valid_sections(pool)) do
        if not used[section] then available[#available + 1] = section end
    end
    if #available == 0 then return nil end
    return available[math.random(1, #available)]
end

-- Use the authoritative RVM classification instead of maintaining a second,
-- inevitably stale list. raid_artefacts_tiers_by_dop groups 1..4 are junk,
-- 5 is T1, 6 is T2, 7 is T3, and 8 is above the sortie tiers in this mod.
local function artifact_pool_for_tier(tier)
    local source = raid_artefacts and raid_artefacts.raid_artefacts_tiers_by_dop
    if type(source) ~= "table" then
        log("ERROR raid_artefacts_tiers_by_dop unavailable; artifact rare reward disabled")
        return {}
    end
    local groups = tier == 1 and { 1, 2, 3, 4, 5 }
        or tier == 2 and { 5, 6 }
        or { 6, 7 }
    local result, seen = {}, {}
    for _, group_id in ipairs(groups) do
        local group = source[group_id]
        for _, section in ipairs(group and group.artefacts or {}) do
            if not seen[section] and ini_sys:section_exist(section) then
                seen[section] = true
                result[#result + 1] = section
            elseif not ini_sys:section_exist(section) then
                log("artifact pool section missing, ignored: group=%s section=%s", tostring(group_id), tostring(section))
            end
        end
    end
    return result
end

local function queue_rvm_artifact(item, section)
    if not item then return false end
    if raid_artefacts and raid_artefacts.addToQueuedArtefacts then
        local ok, err = pcall(raid_artefacts.addToQueuedArtefacts, item)
        if ok then
            log("rare artifact queued: section=%s id=%s", tostring(section), tostring(item.id))
            return true
        end
        log("ERROR artifact queue failed; releasing unrandomized reward: section=%s id=%s error=%s",
            tostring(section), tostring(item.id), tostring(err))
        safe_release(item.id)
        return false
    end
    log("ERROR artifact queue unavailable; releasing unrandomized reward: section=%s id=%s", tostring(section), tostring(item.id))
    safe_release(item.id)
    return false
end

local function append_distinct(target, source, excluded)
    local present = {}
    for _, section in ipairs(target or {}) do present[section] = true end
    for _, section in ipairs(source or {}) do
        if not present[section] and not (excluded and excluded[section]) then
            target[#target + 1] = section
            present[section] = true
        end
    end
    return target
end

local function percent_roll(chance)
    chance = math.max(0, math.min(100, tonumber(chance) or 0))
    return math.random() * 100 < chance
end

local function roll_valuable_quota()
    if not percent_roll(balanced("valuable_first_chance", 35)) then return 0 end
    if not percent_roll(balanced("valuable_second_chance", 10)) then return 1 end
    if not percent_roll(balanced("valuable_third_chance", 1.5)) then return 2 end
    return 3
end

local function weighted_section(pool, weight_for)
    local total = 0
    local entries = {}
    for _, section in ipairs(pool or {}) do
        local weight = math.max(0, tonumber(weight_for(section)) or 0)
        if weight > 0 then
            total = total + weight
            entries[#entries + 1] = { section = section, cumulative = total }
        end
    end
    if total <= 0 then return nil end
    local roll = math.random() * total
    for _, entry in ipairs(entries) do
        if roll < entry.cumulative then return entry.section end
    end
    return entries[#entries] and entries[#entries].section or nil
end

local function fill_loot(box_id)
    local box = alife_object(box_id)
    if not box then return 0 end
    local tier = current_tier()
    local cap = math.max(1, math.floor(balanced("loot_cap", tier == 1 and 6 or tier == 2 and 7 or 8)))
    local medicine = valid_sections(balanced_list("loot_medicine"))
    local valuable = valid_sections(balanced_list("loot_valuable"))
    local ordinary = valid_sections(balanced_list("loot_ordinary"))
    local fragments = {}
    for _, section in ipairs(valid_sections(balanced_list("loot_fragments"))) do fragments[section] = true end
    local entries = {}
    local medicine_sections = {}
    local valuable_sections = {}
    local ordinary_rolls = {}

    local medicine_chance = balanced("medicine_chance", 75)
    local medicine_half = balanced_string("loot_medicine_half_weight", "")
    local first_medicine_success = percent_roll(medicine_chance)
    local medicine_rolls = {
        { chance = medicine_chance, success = first_medicine_success },
        { chance = first_medicine_success and medicine_chance / 2 or medicine_chance },
    }
    medicine_rolls[2].success = percent_roll(medicine_rolls[2].chance)
    for roll_index, roll in ipairs(medicine_rolls) do
        local selected_section = nil
        if roll.success then
            selected_section = weighted_section(medicine, function(candidate)
                return candidate == medicine_half and 0.5 or 1
            end)
            if selected_section then
                entries[#entries + 1] = { section = selected_section, quantity = 1, stage = "medicine" }
                medicine_sections[#medicine_sections + 1] = selected_section
            end
        end
        log("loot medicine roll box=%s roll=%s chance=%s success=%s section=%s",
            tostring(box_id), tostring(roll_index), fmt_number(roll.chance), tostring(roll.success),
            tostring(selected_section or "none"))
    end

    local valuable_quota = roll_valuable_quota()
    local valuable_used = {}
    while #valuable_sections < valuable_quota do
        local candidates = {}
        for _, section in ipairs(valuable) do
            if not valuable_used[section] then candidates[#candidates + 1] = section end
        end
        local section = #candidates > 0 and candidates[math.random(1, #candidates)] or nil
        if not section then break end
        if not (tier == 3 and section == "lead_box") then valuable_used[section] = true end
        entries[#entries + 1] = { section = section, quantity = 1, stage = "valuable" }
        valuable_sections[#valuable_sections + 1] = section
    end

    local ordinary_capacity = math.max(1, cap - #medicine_sections - #valuable_sections)
    local ordinary_count = math.random(1, ordinary_capacity)
    local fragment_min = math.max(1, math.floor(balanced("loot_fragment_quantity_min", tier == 1 and 1 or tier == 2 and 2 or 3)))
    local fragment_max = math.max(fragment_min, math.floor(balanced("loot_fragment_quantity_max", tier == 1 and 3 or tier == 2 and 5 or 7)))
    local nonfragment_weight = balanced("loot_ordinary_nonfragment_weight", tier == 1 and 1 or tier == 2 and 0.75 or 0.5)
    local watch_weight = balanced("loot_hand_watch_weight", nonfragment_weight / 2)
    for roll_index = 1, ordinary_count do
        local section = weighted_section(ordinary, function(candidate)
            if fragments[candidate] then return 1 end
            if candidate == "hand_watch" then return watch_weight end
            return nonfragment_weight
        end)
        if section then
            local quantity = fragments[section] and math.random(fragment_min, fragment_max) or 1
            entries[#entries + 1] = { section = section, quantity = quantity, stage = "ordinary" }
            ordinary_rolls[#ordinary_rolls + 1] = section .. "*" .. tostring(quantity)
        end
    end

    local rare_artifact = nil
    local rare_non_artifact = nil
    local rare_reward = nil
    if percent_roll(balanced("rare_slot_chance", 4)) then
        local artifact_roll = percent_roll(balanced("rare_artifact_chance", 70))
        if artifact_roll then
            local pool = artifact_pool_for_tier(tier)
            if #pool > 0 then rare_artifact = pool[math.random(1, #pool)] end
        else
            local rare = choose_distinct(balanced_list("loot_rare_non_artifact"), {})
            if rare then
                rare_non_artifact = rare
                rare_reward = rare
            end
        end
    end

    local created_entries = {}
    local physical_items = 0
    for _, entry in ipairs(entries) do
        local created_quantity = 0
        for _ = 1, entry.quantity do
            local item = alife_create_item(entry.section, box)
            if item then created_quantity = created_quantity + 1; physical_items = physical_items + 1
            else log("ERROR loot item spawn failed: box=%s section=%s", tostring(box_id), tostring(entry.section)) end
        end
        if created_quantity > 0 then
            created_entries[#created_entries + 1] = entry.section .. (created_quantity > 1 and ("*" .. tostring(created_quantity)) or "")
        end
    end
    if rare_artifact then
        local item = alife_create_item(rare_artifact, box)
        if item then
            if queue_rvm_artifact(item, rare_artifact) then
                rare_reward = rare_artifact
                physical_items = physical_items + 1
            else
                rare_artifact = nil
            end
        else
            log("ERROR rare artifact spawn failed: box=%s section=%s", tostring(box_id), tostring(rare_artifact))
            rare_artifact = nil
        end
    elseif rare_non_artifact then
        local item = alife_create_item(rare_non_artifact, box)
        if item then
            physical_items = physical_items + 1
        else
            log("ERROR rare reward spawn failed: box=%s section=%s", tostring(box_id), tostring(rare_non_artifact))
            rare_reward = nil
        end
    end
    if rare_reward then created_entries[#created_entries + 1] = rare_reward end
    local total_entries = #created_entries
    release_log("loot result tier=%s entries=%s/%s medicine=%s valuable=%s ordinary_rolls=%s rare=%s",
        tostring(tier), tostring(total_entries), tostring(cap + (rare_reward and 1 or 0)),
        tostring(#medicine_sections), tostring(#valuable_sections), tostring(#ordinary_rolls), tostring(rare_reward or "none"))
    log("loot details box=%s medicine_rolls=[%s/%s,%s/%s] medicine=[%s] valuable_quota=%s valuable=[%s] ordinary=[%s] rare=%s entries=[%s]",
        tostring(box_id), fmt_number(medicine_rolls[1].chance), tostring(medicine_rolls[1].success),
        fmt_number(medicine_rolls[2].chance), tostring(medicine_rolls[2].success), join_values(medicine_sections, ","),
        tostring(valuable_quota), join_values(valuable_sections, ","), join_values(ordinary_rolls, ","),
        tostring(rare_reward), join_values(created_entries, ","))
    return total_entries, created_entries
end

local function create_loot_anchor(visual_pos, radius)
    local attempts = math.max(1, math.floor(C.get_number("global", "placement_attempts", 60)))
    local max_offset = math.max(0, radius / 3)
    for attempt = 1, attempts do
        local angle = math.random() * math.pi * 2
        local distance = math.sqrt(math.random()) * max_offset
        local candidate = vector():set(
            visual_pos.x + math.cos(angle) * distance,
            visual_pos.y,
            visual_pos.z + math.sin(angle) * distance)
        local vertex_id = valid_vertex(candidate)
        if vertex_id then
            local fixed = level.vertex_position(vertex_id)
            local actual_offset = distance_xz(fixed, visual_pos)
            if actual_offset <= max_offset and separated(fixed) then
                local anchor_id, center, paw_anchor = create_anchor(fixed)
                if anchor_id then
                    log("loot center accepted attempt=%s offset=%s max=%s", tostring(attempt),
                        fmt_number(actual_offset), fmt_number(max_offset))
                    return anchor_id, center, paw_anchor, actual_offset
                end
            end
        end
    end
    return nil
end

local function create_loot_zone()
    local visuals = valid_sections(balanced_list("loot_container_visuals"))
    if #visuals == 0 then
        log("ERROR no valid loot container visuals configured")
        return false
    end
    local attempts = math.floor(C.get_number("global", "placement_attempts", 60))
    for _ = 1, attempts do
        local radius = random_radius()
        local section = visuals[math.random(1, #visuals)]
        local visual_id, box_id = raid_objects_arranger.spawn_object_rand_point(section, level.name(), 0, true)
        local visual = visual_id and alife_object(visual_id)
        if visual and box_id then
            local anchor_id, center, paw_anchor, loot_offset = create_loot_anchor(visual.position, radius)
            if anchor_id then
                local total, created_sections = fill_loot(box_id)
                if total >= 1 then
                    return add_zone("loot", anchor_id, center, radius, {
                        content_id = box_id,
                        visual_id = visual_id,
                        visual_pos = pos_table(visual.position),
                        loot_offset = loot_offset,
                        loot_sections = created_sections,
                        managed_visual = true,
                        paw_anchor = paw_anchor,
                    }) ~= nil
                end
            end
            safe_release(box_id)
            if anchor_id then release_anchor({ anchor_id = anchor_id, paw_anchor = paw_anchor }) end
        elseif box_id then
            safe_release(box_id)
        end
        if visual_id then raid_objects_arranger.release_raid_objects(visual_id) end
    end
    log("ERROR loot zone placement or content generation failed")
    return false
end

local function create_decoy(kind)
    if kind == "loot" then return create_loot_zone() end
    local radius = random_radius()
    local anchor_id, center, paw_anchor, center_stage = random_decoy_anchor(kind, radius)
    if not anchor_id then return false end
    local zone = add_zone(kind, anchor_id, center, radius, { paw_anchor = paw_anchor, center_stage = center_stage })
    if zone and kind == "enemy" then
        local timing = string.lower(balanced_string("ambush_spawn_timing", "proximity"))
        zone.spawn_timing = timing == "start" and "start" or "proximity"
        log("enemy zone armed anchor=%s spawn_timing=%s", tostring(zone.anchor_id), tostring(zone.spawn_timing))
    end
    return zone ~= nil
end

local function enabled_weights()
    local weights = {
        enemy = C.get_bool("global", "enable_enemy_decoys", true) and math.max(0, C.get_number("global", "weight_enemy", 50)) or 0,
        loot = C.get_bool("global", "enable_loot_decoys", true) and math.max(0, C.get_number("global", "weight_loot", 25)) or 0,
        empty = C.get_bool("global", "enable_empty_decoys", true) and math.max(0, C.get_number("global", "weight_empty", 25)) or 0,
    }
    return weights
end

local function weighted_decoy(weights)
    local forced = string.lower(C.get_string("global", "debug_force_decoy_type", "off"))
    if forced == "enemy" or forced == "loot" or forced == "empty" then return forced end
    local total = weights.enemy + weights.loot + weights.empty
    if total <= 0 then return nil end
    local roll = math.random() * total
    if roll < weights.enemy then return "enemy" end
    if roll < weights.enemy + weights.loot then return "loot" end
    return "empty"
end

local function create_decoys()
    if state.decoys_created then return end
    state.decoys_created = true
    local true_count = state.counters.artifact or 0
    local weights = enabled_weights()
    if true_count < 1 then return end
    if string.lower(C.get_string("global", "debug_force_decoy_type", "off")) == "artifact" then
        log("debug_force_decoy_type=artifact: only real artifact areas retained")
        return
    end
    local false_count = 1
    if level.name() == "k01_darkscape" then
        false_count = math.random(2, 4)
    elseif level.name() == "l09_deadcity" then
        local roll = math.random(1, 100)
        false_count = roll <= 20 and 1 or roll <= 80 and 2 or 3
    end
    release_log("decoy plan level=%s true=%s false=%s type_weights=50/25/25",
        tostring(level.name()), tostring(true_count), tostring(false_count))
    for index = 1, false_count do
        local kind = weighted_decoy(weights)
        if kind then
            local created = create_decoy(kind)
            release_log("decoy result index=%s/%s selected=%s created=%s type_preserved=true",
                tostring(index), tostring(false_count), tostring(kind), tostring(created))
            if not created then
                log("ERROR decoy creation failed level=%s index=%s/%s selected=%s; type preserved, no replacement created",
                    tostring(level.name()), tostring(index), tostring(false_count), tostring(kind))
            end
        end
    end
end

local function stock_spawn_radius()
    local fallback = balanced("ambush_spawn_safe_fallback", 85)
    if raid_dospawn_dungeons and raid_dospawn_dungeons.raid_sim_dospawn
    and raid_dospawn_dungeons.raid_sim_dospawn[level.name()]
    and raid_dospawn_dungeons.raid_sim_dospawn[level.name()]["infected"] then
        local value = raid_dospawn_dungeons.raid_sim_dospawn[level.name()]["infected"].spawn_block_radius
        if value then return value end
    end
    log("stock respawn exclusion unavailable; fallback=%s", fmt_number(fallback))
    return fallback
end

local function current_view_context()
    local actor_pos = db.actor:position()
    local dir = db.actor:direction()
    local source = "actor"
    local camera_ok, camera_pos, camera_dir = pcall(function()
        local current_device = device()
        return current_device.cam_pos, current_device.cam_dir
    end)
    if camera_ok and camera_pos and camera_dir then
        actor_pos = camera_pos
        dir = camera_dir
        source = "camera"
    end
    return actor_pos, dir, source
end

local function view_metrics(pos)
    local actor_pos, dir, source = current_view_context()
    local vx, vz = pos.x - actor_pos.x, pos.z - actor_pos.z
    local len = math.sqrt(vx * vx + vz * vz)
    local dlen = math.sqrt(dir.x * dir.x + dir.z * dir.z)
    if len < 0.01 or dlen < 0.01 then return false, 1, source end
    local cosine = (vx * dir.x + vz * dir.z) / (len * dlen)
    return cosine < 0.35, cosine, source
end

local function ambush_retry_context_changed(zone)
    if not (zone.ambush_retry_actor_pos and zone.ambush_retry_view_dir) then return true end
    if distance_xz(db.actor:position(), zone.ambush_retry_actor_pos) >= 10 then return true end
    local _, dir = current_view_context()
    local old = zone.ambush_retry_view_dir
    local old_len = math.sqrt(old.x * old.x + old.z * old.z)
    local new_len = math.sqrt(dir.x * dir.x + dir.z * dir.z)
    if old_len < 0.01 or new_len < 0.01 then return true end
    local cosine = (old.x * dir.x + old.z * dir.z) / (old_len * new_len)
    return cosine < 0.94
end

local function server_level_name(obj)
    if not obj then return nil end
    local ok, name = pcall(function()
        if not obj.m_game_vertex_id then return nil end
        local vertex = game_graph():vertex(obj.m_game_vertex_id)
        return vertex and alife():level_name(vertex:level_id()) or nil
    end)
    return ok and name or nil
end

local function on_current_level(obj)
    return server_level_name(obj) == level.name()
end

local function anomaly_shape_radius(obj)
    local unknown = balanced("ambush_unknown_anomaly_radius", 20)
    local ok, data = pcall(function() return utils_stpk.get_anom_zone_data(obj) end)
    if not (ok and data and data.shapes and #data.shapes > 0) then return unknown, "fallback" end
    local radius = 0
    for _, shape in ipairs(data.shapes) do
        local offset = shape.offset
        local offset_xz = offset and math.sqrt((offset.x or 0) * (offset.x or 0) + (offset.z or 0) * (offset.z or 0)) or 0
        if shape.shtype == 0 and tonumber(shape.radius) then
            radius = math.max(radius, tonumber(shape.radius) + offset_xz)
        else
            -- Box matrices are not exposed as a stable half-extent API. Use a
            -- conservative bound instead of guessing that the centre is safe.
            radius = math.max(radius, unknown + offset_xz)
        end
    end
    return radius, "shape"
end

local function collect_anomaly_positions()
    local result = {}
    local scan = { current = 0, offlevel = 0, unreadable_level = 0, non_anomaly = 0 }
    for id = 1, 65534 do
        local object_ok, obj = pcall(alife_object, id)
        if object_ok and obj then
            local anomaly_ok, is_anomaly = pcall(IsAnomaly, obj)
            if anomaly_ok and is_anomaly then
                local object_level = server_level_name(obj)
                if object_level == level.name() then
                    local pos = safe_object_position(obj)
                    if pos then
                        local radius, radius_source = anomaly_shape_radius(obj)
                        result[#result + 1] = {
                            id = id,
                            section = object_section(obj) or "unknown",
                            pos = pos,
                            radius = radius,
                            radius_source = radius_source,
                        }
                        scan.current = scan.current + 1
                    else
                        scan.unreadable_level = scan.unreadable_level + 1
                    end
                elseif object_level then
                    scan.offlevel = scan.offlevel + 1
                else
                    scan.unreadable_level = scan.unreadable_level + 1
                end
            else
                scan.non_anomaly = scan.non_anomaly + 1
            end
        end
    end
    log("ambush anomaly scan level=%s current=%s offlevel_ignored=%s unreadable_fail_closed=%s",
        tostring(level.name()), tostring(scan.current), tostring(scan.offlevel), tostring(scan.unreadable_level))
    return result, scan.unreadable_level == 0
end

local function anomaly_distance(pos, anomaly_positions)
    local nearest_edge = 999999
    local nearest_center = 999999
    local nearest_anomaly = nil
    for _, anomaly in ipairs(anomaly_positions or {}) do
        local center_distance = distance_xz(pos, anomaly.pos)
        local edge_distance = center_distance - (anomaly.radius or 0)
        if edge_distance < nearest_edge then
            nearest_edge = edge_distance
            nearest_center = center_distance
            nearest_anomaly = anomaly
        end
    end
    return nearest_edge, nearest_anomaly, nearest_center
end

local function ambush_spawn_squad(zone, spawn_timing)
    local min_d = math.floor(balanced("enemy_spawn_distance_min", 35))
    local max_d = math.floor(balanced("enemy_spawn_distance_max", 90))
    local stock_safe = stock_spawn_radius()
    local actor_safe = math.max(stock_safe + balanced("ambush_extra_padding", 20), min_d)
    local anomaly_clearance = balanced("ambush_anomaly_clearance", 15)
    local inside_margin = math.max(0, balanced("ambush_start_zone_margin", 8))
    local inside_limit = math.max(0, zone.radius - math.min(zone.radius, inside_margin))
    local outside_padding = math.max(1, balanced("ambush_outside_zone_padding", 25))
    local attempts = math.max(1, math.floor(C.get_number("global", "placement_attempts", 60)))

    local search_dir = db.actor:direction()
    local direction_source = "actor"
    if spawn_timing == "proximity" then
        local ok, camera_dir = pcall(function() return device().cam_dir end)
        if ok and camera_dir then search_dir, direction_source = camera_dir, "camera" end
    elseif state.start_pos then
        search_dir = { x = zone.center.x - state.start_pos.x, y = 0, z = zone.center.z - state.start_pos.z }
        direction_source = "start_to_zone"
    end
    local length = math.sqrt(search_dir.x * search_dir.x + search_dir.z * search_dir.z)
    local forward_x = length >= 0.01 and search_dir.x / length or 1
    local forward_z = length >= 0.01 and search_dir.z / length or 0
    local right_x, right_z = -forward_z, forward_x

    local function ring_candidate(distance_min, distance_max, index)
        local radial_slots = 5
        local radial_index = (index - 1) % radial_slots
        local angular_index = math.floor((index - 1) / radial_slots)
        local angular_slots = math.max(1, math.ceil(attempts / radial_slots))
        local angle = math.pi + angular_index * math.pi * 2 / angular_slots
        local distance = distance_min + (distance_max - distance_min) * radial_index / math.max(1, radial_slots - 1)
        local offset_forward = math.cos(angle) * distance
        local offset_right = math.sin(angle) * distance
        return vector():set(zone.center.x + forward_x * offset_forward + right_x * offset_right,
            zone.center.y, zone.center.z + forward_z * offset_forward + right_z * offset_right)
    end

    local stages = nil
    if spawn_timing == "start" then
        stages = {
            { name = "inside_clear", min_zone = 0, max_zone = inside_limit, require_view = false, require_anomaly_clear = true },
            { name = "inside_anomaly_allowed", min_zone = 0, max_zone = inside_limit, require_view = false, require_anomaly_clear = false },
            { name = "outside_anomaly_allowed", min_zone = zone.radius + 1, max_zone = zone.radius + outside_padding, require_view = false, require_anomaly_clear = false },
        }
    else
        stages = {
            { name = "inside_hidden_clear", min_zone = 0, max_zone = inside_limit, require_view = true, require_anomaly_clear = true },
            { name = "inside_hidden_anomaly_allowed", min_zone = 0, max_zone = inside_limit, require_view = true, require_anomaly_clear = false },
            { name = "outside_hidden_anomaly_allowed", min_zone = zone.radius + 1, max_zone = zone.radius + outside_padding, require_view = true, require_anomaly_clear = false },
            { name = "outside_visible_last_resort", min_zone = zone.radius + 1, max_zone = zone.radius + outside_padding, require_view = false, require_anomaly_clear = false },
        }
    end

    for stage_index, stage in ipairs(stages) do
        local stats = { invalid = 0, duplicate = 0, band = 0, actor = 0, start = 0, view = 0, anomaly = 0, unreadable = 0, spawn = 0 }
        local seen_vertices = {}
        log("ambush cascade begin anchor=%s tier=%s preset=%s step=%s/%s name=%s timing=%s zone_band=%s..%s view_required=%s anomaly_clear_required=%s scan_complete=%s",
            tostring(zone.anchor_id), tostring(current_tier()), tostring(zone.squad_section), tostring(stage_index), tostring(#stages),
            tostring(stage.name), tostring(spawn_timing), fmt_number(stage.min_zone), fmt_number(stage.max_zone),
            tostring(stage.require_view), tostring(stage.require_anomaly_clear), tostring(zone.anomaly_scan_complete))
        for attempt = 1, attempts do
            local candidate = ring_candidate(stage.min_zone, stage.max_zone, attempt)
            local lvid = valid_vertex(candidate)
            if not lvid then
                stats.invalid = stats.invalid + 1
            elseif seen_vertices[tostring(lvid)] then
                stats.duplicate = stats.duplicate + 1
            else
                seen_vertices[tostring(lvid)] = true
                local pos = level.vertex_position(lvid)
                local zone_distance = distance_xz(pos, zone.center)
                local actor_distance = distance_xz(pos, db.actor:position())
                local start_distance = state.start_pos and distance_xz(pos, state.start_pos) or actor_distance
                local outside_view, view_cosine, view_source = view_metrics(pos)
                local edge_clearance, nearest_anomaly = anomaly_distance(pos, zone.anomaly_positions)
                local accepted = true
                if zone_distance < stage.min_zone or zone_distance > stage.max_zone then stats.band = stats.band + 1; accepted = false end
                if actor_distance < actor_safe then stats.actor = stats.actor + 1; accepted = false end
                if spawn_timing == "start" and start_distance < actor_safe then stats.start = stats.start + 1; accepted = false end
                if stage.require_view and not outside_view then stats.view = stats.view + 1; accepted = false end
                if stage.require_anomaly_clear and zone.anomaly_scan_complete == false then stats.unreadable = stats.unreadable + 1; accepted = false end
                if stage.require_anomaly_clear and edge_clearance < anomaly_clearance then stats.anomaly = stats.anomaly + 1; accepted = false end
                if accepted then
                    local created, create_error = spawn_exact_squad(zone, pos, lvid, stage.name)
                    if created then
                        log("ambush cascade success anchor=%s tier=%s preset=%s step=%s/%s name=%s position=(%s) actor_dxz=%s start_dxz=%s zone_dxz=%s view_cos=%s view_source=%s nearest_anomaly=%s anomaly_edge_clearance=%s profile=%s..%s direction_source=%s",
                            tostring(zone.anchor_id), tostring(current_tier()), tostring(zone.squad_section), tostring(stage_index), tostring(#stages),
                            tostring(stage.name), fmt_position(pos), fmt_number(actor_distance), fmt_number(start_distance), fmt_number(zone_distance),
                            fmt_number(view_cosine), tostring(view_source), tostring(nearest_anomaly and nearest_anomaly.id or "none"),
                            fmt_number(edge_clearance), tostring(min_d), tostring(max_d), tostring(direction_source))
                        zone.spawn_cascade_step = stage.name
                        return true
                    end
                    stats.spawn = stats.spawn + 1
                    log("ambush cascade candidate spawn failed anchor=%s preset=%s step=%s attempt=%s reason=%s; rollback complete",
                        tostring(zone.anchor_id), tostring(zone.squad_section), tostring(stage.name), tostring(attempt), tostring(create_error))
                end
            end
        end
        log("ambush cascade exhausted anchor=%s tier=%s preset=%s step=%s/%s name=%s attempts=%s reject=invalid:%s,duplicate:%s,band:%s,actor:%s,start:%s,view:%s,anomaly:%s,unreadable:%s,spawn:%s",
            tostring(zone.anchor_id), tostring(current_tier()), tostring(zone.squad_section), tostring(stage_index), tostring(#stages),
            tostring(stage.name), tostring(attempts), tostring(stats.invalid), tostring(stats.duplicate), tostring(stats.band),
            tostring(stats.actor), tostring(stats.start), tostring(stats.view), tostring(stats.anomaly), tostring(stats.unreadable), tostring(stats.spawn))
    end
    return false
end

local function owned_enemy(id)
    for _, zone in pairs(state.zones or {}) do
        if zone.kind == "enemy" and zone.spawned_ids and zone.spawned_ids[id] then return true end
    end
    return false
end

local function safe_object_id(obj)
    return safe_object_id_any(obj)
end

local function safe_alife_object(id)
    if not id then return nil end
    local ok, obj = pcall(alife_object, id)
    return ok and obj or nil
end

local function safe_alive_method(obj)
    if not obj then return nil end
    local ok, method = pcall(function() return obj.alive end)
    if not (ok and type(method) == "function") then return nil end
    local result_ok, result = pcall(method, obj)
    if not result_ok then return nil end
    return result == true
end

safe_alive = function(id, server_obj)
    if id and level then
        local ok, online = pcall(function() return level.object_by_id(id) end)
        if ok and online then
            local alive = safe_alive_method(online)
            if alive ~= nil then return alive, "online_alive" end
        end
    end

    local obj = safe_alife_object(id) or server_obj
    local alive = safe_alive_method(obj)
    if alive ~= nil then return alive, "server_alive" end
    for _, field in ipairs({ "health", "m_fHealth" }) do
        local ok, health = pcall(function() return obj and obj[field] end)
        if ok and type(health) == "number" then return health > 0, "server_" .. field end
    end
    return nil, "unknown"
end

local function safe_class_check(check, obj)
    if type(check) ~= "function" or not obj then return false end
    local ok, result = pcall(check, obj)
    if ok then return result == true end
    local cls_ok, clsid = pcall(function() return obj:clsid() end)
    if not (cls_ok and clsid) then return false end
    ok, result = pcall(check, nil, clsid)
    return ok and result == true
end

local function disable_census(context, err)
    census_disabled = true
    if census_error_reported then return end
    census_error_reported = true
    printf(PREFIX .. " ERROR census disabled context=%s error=%s", tostring(context), tostring(err))
end

local function population_census_impl(reason)
    if not debug_enabled() then
        return nil, "diagnostics disabled"
    end
    local stalkers, mutants, squads = 0, 0, 0
    local member_ids = {}
    log("census begin reason=%s level=%s", tostring(reason), tostring(level.name()))
    local sortie_type = state.sortie_type or (z_raid_item_travel_dungeons and z_raid_item_travel_dungeons.type_dungeon)
    local level_cfg = raid_dospawn_dungeons and raid_dospawn_dungeons.raid_sim_dospawn
        and raid_dospawn_dungeons.raid_sim_dospawn[level.name()]
    local dospawn_cfg = level_cfg and level_cfg[sortie_type]
    if dospawn_cfg then
        local ratio = dospawn_cfg.fill_ratio_squads or {}
        log("census rvm_config type=%s raid_timer=%s number_squads=%s fill=%s..%s time_between=%s mutant_chance=%s",
            tostring(sortie_type), tostring(raid_main and raid_main.raid_timer), tostring(dospawn_cfg.number_squads),
            tostring(ratio.min), tostring(ratio.max), tostring(dospawn_cfg.time_between_dospawns),
            tostring(dospawn_cfg.mutant_spawn_chance))
    end
    for squad_id, _ in pairs(SIMBOARD and SIMBOARD.squads or {}) do
        local squad = alife_object(squad_id)
        if squad and on_current_level(squad) then
            squads = squads + 1
            local members = {}
            local squad_owned = false
            for member in squad:squad_members() do
                local id = safe_object_id(member)
                local server_member = safe_alife_object(id) or member
                local alive, alive_source = safe_alive(id, server_member)
                local owned = owned_enemy(id)
                local section = object_section(server_member)
                if id then member_ids[id] = true end
                squad_owned = squad_owned or owned
                if alive == true and safe_class_check(IsStalker, server_member) then stalkers = stalkers + 1 end
                if alive == true and safe_class_check(IsMonster, server_member) then mutants = mutants + 1 end
                members[#members + 1] = tostring(section) .. "#" .. tostring(id)
                    .. "(alive=" .. tostring(alive == nil and "unknown" or alive)
                    .. ",alive_source=" .. tostring(alive_source)
                    .. ",owned_by_rework=" .. tostring(owned) .. ")"
            end
            table.sort(members)
            log("census squad id=%s section=%s owned_by_rework=%s members=[%s]",
                tostring(squad_id), tostring(object_section(squad)), tostring(squad_owned), join_values(members, ";"))
        end
    end
    for _, zone in pairs(state.zones or {}) do
        for id, _ in pairs(zone.spawned_ids or {}) do
            if not member_ids[id] then
                local obj = safe_alife_object(id)
                local info = zone.spawned_info and zone.spawned_info[id] or {}
                local alive, alive_source = safe_alive(id, obj)
                if alive == true and safe_class_check(IsStalker, obj) then stalkers = stalkers + 1 end
                if alive == true and safe_class_check(IsMonster, obj) then mutants = mutants + 1 end
                log("census loose id=%s section=%s alive=%s alive_source=%s owned_by_rework=true",
                    tostring(id), tostring(info.section or object_section(obj)),
                    tostring(alive == nil and "unknown" or alive), tostring(alive_source))
            end
        end
        if not zone.closed and zone.kind == "artifact" then
            local snapshot_ok, snapshot = pcall(artifact_snapshot, zone)
            if snapshot_ok then
                log("artifact diagnostic reason=census anchor=%s linked=%s %s",
                    tostring(zone.anchor_id), tostring(zone.artifact_id), artifact_diagnostic_text(snapshot))
            else
                log("ERROR artifact diagnostic failed reason=census anchor=%s linked=%s error=%s",
                    tostring(zone.anchor_id), tostring(zone.artifact_id), tostring(snapshot))
            end
        end
    end
    log("census end reason=%s squads=%s stalkers=%s mutants=%s",
        tostring(reason), tostring(squads), tostring(stalkers), tostring(mutants))
    return { squads = squads, stalkers = stalkers, mutants = mutants }
end

local function population_census(reason)
    if census_disabled then return nil, "disabled after an earlier diagnostic error" end
    local ok, summary, detail = pcall(population_census_impl, reason)
    if not ok then
        disable_census("population_census:" .. tostring(reason), summary)
        return nil, tostring(summary)
    end
    return summary, detail
end

local function detect_rvm_squad_changes_impl()
    if not debug_enabled() then return end
    local current, added = {}, {}
    for squad_id, _ in pairs(raid_simulation_dungeons and raid_simulation_dungeons.raid_squads_dunge or {}) do
        local squad = alife_object(squad_id)
        if squad and on_current_level(squad) then
            current[tostring(squad_id)] = true
            if state.census_initialized and not state.census_squads[tostring(squad_id)] then
                added[#added + 1] = tostring(squad_id) .. ":" .. tostring(object_section(squad))
            end
        end
    end
    state.census_squads = current
    if not state.census_initialized then
        state.census_initialized = true
        population_census("sortie_start")
    elseif #added > 0 then
        table.sort(added)
        population_census("rvm_squad_added=" .. join_values(added, ","))
    end
end

local function detect_rvm_squad_changes()
    if census_disabled then return false end
    local ok, err = pcall(detect_rvm_squad_changes_impl)
    if not ok then
        disable_census("detect_rvm_squad_changes", err)
        return false
    end
    return true
end

local function defer_ambush(zone, now, reason)
    zone.ambush_retry_count = (zone.ambush_retry_count or 0) + 1
    local retry_delay = math.max(1000, C.get_number("global", "ambush_retry_delay_ms", 10000))
    zone.ambush_retry_at = (now or time_global()) + retry_delay
    local _, retry_dir = current_view_context()
    zone.ambush_retry_actor_pos = pos_table(db.actor:position())
    zone.ambush_retry_view_dir = pos_table(retry_dir)
    log("ambush deferred anchor=%s reason=%s retry=%s after_ms=%s resume_after=actor_moves_10m_or_camera_turns_20deg; zone remains armed",
        tostring(zone.anchor_id), tostring(reason), tostring(zone.ambush_retry_count), tostring(retry_delay))
end

local function trigger_ambush(zone, now, spawn_timing)
    if zone.triggered then return end
    spawn_timing = spawn_timing == "start" and "start" or "proximity"
    zone.member_ids = zone.member_ids or {}
    zone.spawned_ids = zone.member_ids
    zone.spawned_info = zone.spawned_info or {}
    local category, preset, preset_error = choose_enemy_preset(zone)
    if not (category and preset) then
        log("ERROR ambush preset unavailable anchor=%s tier=%s reason=%s; zone remains armed",
            tostring(zone.anchor_id), tostring(current_tier()), tostring(preset_error))
        defer_ambush(zone, now, "preset_unavailable")
        return
    end
    local fixed_members, validation_error = preset_members(preset)
    if not fixed_members then
        log("ERROR ambush preset invalid anchor=%s tier=%s preset=%s reason=%s; zone remains armed",
            tostring(zone.anchor_id), tostring(current_tier()), tostring(preset), tostring(validation_error))
        defer_ambush(zone, now, "invalid_exact_preset")
        return
    end
    if not zone.anomaly_positions then
        zone.anomaly_positions, zone.anomaly_scan_complete = collect_anomaly_positions()
    end
    if not ambush_spawn_squad(zone, spawn_timing) then
        defer_ambush(zone, now, "cascade_exhausted_no_complete_squad")
    else
        zone.triggered = true
        zone.spawn_timing_resolved = spawn_timing
        zone.ambush_retry_at = nil
        zone.ambush_retry_actor_pos = nil
        zone.ambush_retry_view_dir = nil
        release_log("enemy squad ready tier=%s preset=%s cascade=%s members=%s",
            tostring(current_tier()), tostring(zone.squad_section), tostring(zone.spawn_cascade_step),
            tostring(size_table(zone.spawned_ids)))
        log("ambush anchor=%s tier=%s category=%s preset=%s squad_id=%s spawn_timing=%s cascade=%s spawned=%s",
            tostring(zone.anchor_id), tostring(current_tier()), tostring(zone.squad_category), tostring(zone.squad_section),
            tostring(zone.squad_id), tostring(spawn_timing), tostring(zone.spawn_cascade_step), tostring(size_table(zone.spawned_ids)))
        refresh_zone_spots(zone)
        population_census("rework_enemy_created anchor=" .. tostring(zone.anchor_id))
        zone.anomaly_positions = nil
        zone.anomaly_scan_complete = nil
    end
end

local function refresh_zone_squad_members(zone)
    if not (zone and zone.squad_id) then return true end
    local ok, squad = pcall(alife_object, zone.squad_id)
    if not (ok and squad) then return true end
    local ids, sections, _, err = enumerate_squad_members(squad)
    if not ids then
        if not zone.member_refresh_error_reported then
            zone.member_refresh_error_reported = true
            log("ERROR ambush squad enumeration failed squad_id=%s preset=%s error=%s; zone kept open",
                tostring(zone.squad_id), tostring(zone.squad_section), tostring(err))
        end
        return false
    end
    zone.member_refresh_error_reported = nil
    zone.member_ids = zone.member_ids or {}
    zone.spawned_ids = zone.member_ids
    zone.spawned_info = zone.spawned_info or {}
    for index, id in ipairs(ids) do
        zone.member_ids[id] = true
        local info = zone.spawned_info[id] or {}
        info.section = sections[index]
        if info.resolved == nil then info.resolved = false end
        zone.spawned_info[id] = info
    end
    return true
end

local function update_artifact_zones(now)
    local emit_diagnostic = debug_enabled() and now >= next_artifact_diagnostic
    if emit_diagnostic then next_artifact_diagnostic = now + 15000 end
    local exact_candidates = {}
    for _, zone in pairs(state.zones or {}) do
        if not zone.closed and zone.kind == "artifact" then
            local ok, snapshot = pcall(artifact_snapshot, zone)
            if not ok then
                if not zone.ownership_error_reported then
                    zone.ownership_error_reported = true
                    log("ERROR artifact ownership check failed anchor=%s linked=%s error=%s; zone kept open",
                        tostring(zone.anchor_id), tostring(zone.artifact_id), tostring(snapshot))
                end
            else
                zone.ownership_error_reported = nil
                sync_artifact_exact_spot(zone, snapshot, emit_diagnostic)
                local exact_pos = snapshot.online_pos or snapshot.server_pos
                if snapshot.actor_owned then
                    log("artifact ownership acquired anchor=%s linked=%s source=%s chain=%s",
                        tostring(zone.anchor_id), tostring(zone.artifact_id), tostring(snapshot.ownership_source),
                        join_values(snapshot.parent_chain, ">"))
                    close_zone(zone, "actor_owns_linked_artifact")
                else
                    if artifact_exact_marker_enabled() and snapshot.server_exists and exact_pos then
                        exact_candidates[#exact_candidates + 1] = {
                            id = zone.artifact_id,
                            section = zone.artifact_section,
                            pos = exact_pos,
                        }
                    end
                    if emit_diagnostic then
                        log("artifact diagnostic reason=periodic anchor=%s linked=%s %s",
                            tostring(zone.anchor_id), tostring(zone.artifact_id), artifact_diagnostic_text(snapshot))
                    end
                end
            end
        end
    end
    diagnose_artifact_exact_overlaps(exact_candidates)
end

local function update_zones(now)
    update_artifact_zones(now)
    for _, zone in pairs(state.zones) do
        if not zone.closed and zone.kind == "enemy" then
            if not zone.triggered then
                local spawn_timing = zone.spawn_timing
                if spawn_timing ~= "start" and spawn_timing ~= "proximity" then
                    local configured = string.lower(balanced_string("ambush_spawn_timing", "proximity"))
                    spawn_timing = configured == "start" and "start" or "proximity"
                    zone.spawn_timing = spawn_timing
                end
                local trigger = zone.radius + balanced("ambush_trigger_padding", 130)
                local retry_ready = now >= (zone.ambush_retry_at or 0) and ambush_retry_context_changed(zone)
                local timing_ready = spawn_timing == "start" or distance_xz(db.actor:position(), zone.center) <= trigger
                if retry_ready and timing_ready then trigger_ambush(zone, now, spawn_timing) end
            else
                local alive = 0
                local members_known = refresh_zone_squad_members(zone)
                for id, _ in pairs(zone.spawned_ids or {}) do
                    local obj_ok, obj = pcall(alife_object, id)
                    obj = obj_ok and obj or nil
                    local info = zone.spawned_info and zone.spawned_info[id]
                    local entity_alive, alive_source = safe_alive(id, obj)
                    if entity_alive == true or (entity_alive == nil and obj) then
                        alive = alive + 1
                    elseif info and not info.resolved then
                        info.resolved = true
                        info.reason = obj and "dead" or "alife_missing"
                        log("ambush entity resolved section=%s id=%s reason=%s",
                            tostring(info.section), tostring(id), tostring(info.reason))
                    end
                end
                sync_enemy_squad_exact_spot(zone)
                if not members_known then
                    alive = math.max(alive, 1)
                end
                if alive == 0 then close_zone(zone, "ambush_squad_resolved_all_dead_or_missing") end
            end
        end
    end
end

local function create_scouting_stash()
    if state.scouting_stash_created then return end
    state.scouting_stash_created = true
    local id, name, descr, hint = treasure_manager.get_random_stash(nil, game.translate_string("st_stash_of"), nil, nil, nil, nil, level.name())
    if not id then log("ERROR scouting stash creation failed: no free stash found"); return end
    state.stash_ids[id] = true
    raid_tasks_main.raid_busy_stashes_t[id] = true
    if level.map_has_object_spot(id, "secondary_task_location") == 0 then
        level.map_add_object_spot_ser(id, "secondary_task_location", dynamic_news_helper.GetPointDescription(alife_object(id)))
    end
    treasure_manager.set_random_stash(nil, dynamic_news_helper.GetPointDescription(alife_object(id)), nil, id, true)
    release_log("scouting stash created")
    log("scouting stash details id=%s", tostring(id))
end

local function prepare_sortie(sortie_type)
    if state.level_name and (state.level_name ~= level.name() or state.sortie_type ~= sortie_type) then cleanup("new_sortie") end
    state.level_name = level.name()
    state.sortie_type = sortie_type
    state.start_capture_after = time_global() + 1200
    if sortie_type == "infected" then
        local mode = string.lower(C.get_string("global", "stash_mode", "scouting"))
        if mode ~= "anomaly" then state.suppress_stash_calls = 10 end
    elseif sortie_type == "scouting" and string.lower(C.get_string("global", "stash_mode", "scouting")) == "scouting" then
        state.need_scouting_stash = true
    end
    release_log("prepare type=%s level=%s", tostring(sortie_type), tostring(level.name()))
    log("prepare details type=%s level=%s", tostring(sortie_type), tostring(level.name()))
end

local function install_hooks()
    if hooks_installed then return end
    hooks_installed = true

    if raid_anomalys and raid_anomalys.spawn_artefact_in_zone then
        local base_spawn_artifact = raid_anomalys.spawn_artefact_in_zone
        raid_anomalys.spawn_artefact_in_zone = function(anom_zone, pos, level_tier)
            local artifact_id = base_spawn_artifact(anom_zone, pos, level_tier)
            if enabled() and artifact_id and state.sortie_type == "infected" and state.level_name == level.name() then
                state.pending_artifacts[tostring(artifact_id)] = artifact_id
                state.last_artifact_time = time_global()
                log("captured raid artifact id=%s zone=%s", tostring(artifact_id), tostring(anom_zone))
            end
            return artifact_id
        end
    else
        printf(PREFIX .. " ERROR raid_anomalys.spawn_artefact_in_zone not found")
    end

    if raid_tasks_dungeons and raid_tasks_dungeons.issue_task_dungeon then
        local base_issue = raid_tasks_dungeons.issue_task_dungeon
        raid_tasks_dungeons.issue_task_dungeon = function(sortie_type)
            if enabled() then prepare_sortie(sortie_type) end
            return base_issue(sortie_type)
        end
    else
        printf(PREFIX .. " ERROR raid_tasks_dungeons.issue_task_dungeon not found")
    end

    if treasure_manager and treasure_manager.get_random_stash then
        local base_get_stash = treasure_manager.get_random_stash
        treasure_manager.get_random_stash = function(...)
            if enabled() and state.suppress_stash_calls and state.suppress_stash_calls > 0
            and state.sortie_type == "infected" and state.level_name == level.name() then
                state.suppress_stash_calls = state.suppress_stash_calls - 1
                log("suppressed anomaly-sortie stash attempt; remaining=%s", tostring(state.suppress_stash_calls))
                return nil
            end
            return base_get_stash(...)
        end
    end

    if ui_item and ui_item.build_desc_header then
        local base_header = ui_item.build_desc_header
        ui_item.build_desc_header = function(obj, sec, str)
            local result = base_header(obj, sec, str)
            if enabled() and sec and string.find(sec, "raid_map_travel_") then
                local mode = string.lower(C.get_string("global", "stash_mode", "scouting"))
                local matches = (mode == "scouting" and string.find(sec, "_scouting")) or (mode == "anomaly" and string.find(sec, "_infected"))
                if matches then result = result .. game.translate_string("st_rvm_sorties_stash_suffix") end
            end
            return result
        end
    end
end

-- Some RVM remote NPC pickup paths destroy the original world artefact and create a
-- replacement object in the NPC inventory. When the actor later loots that
-- replacement, its ID no longer matches the exact ID captured at spawn time.
-- Accept that lineage only when the old object is gone, the section matches,
-- and exactly one open zone qualifies; ambiguity deliberately keeps zones open.
local function recreated_artifact_zone(item)
    local section = object_section(item)
    if not section then return nil end
    local candidate = nil
    local count = 0
    for _, zone in pairs(state.zones or {}) do
        if not zone.closed and zone.kind == "artifact" and zone.artifact_section == section then
            local old_ok, old_obj = pcall(alife_object, zone.artifact_id)
            if old_ok and not old_obj then
                candidate = zone
                count = count + 1
            end
        end
    end
    return count == 1 and candidate or nil
end

local function actor_on_item_take(item)
    if not item then return end
    local item_id = safe_object_id_any(item)
    local key = tostring(item_id)
    local anchor_key = state.artifact_zone[key]
    local zone = anchor_key and state.zones[anchor_key]
    if zone then
        close_zone(zone, "actor_pickup")
        return
    end
    zone = recreated_artifact_zone(item)
    if zone then
        log("artifact lineage recovered anchor=%s old=%s replacement=%s section=%s",
            tostring(zone.anchor_id), tostring(zone.artifact_id), tostring(item_id), tostring(zone.artifact_section))
        close_zone(zone, "actor_pickup_recreated_id")
    end
end

local function npc_on_item_take(npc, item)
    if not (item and C.get_bool("global", "remove_on_npc_pickup", false)) then return end
    local anchor_key = state.artifact_zone[tostring(item:id())]
    local zone = anchor_key and state.zones[anchor_key]
    if zone then close_zone(zone, "npc_pickup") end
end

local function physic_object_on_use_callback(box, who)
    if not box then return end
    for _, zone in pairs(state.zones) do
        if not zone.closed and zone.kind == "loot" and zone.content_id == box:id() then
            close_zone(zone, "container_opened")
            return
        end
    end
end

local function actor_on_first_update()
    install_hooks()
    local current_level = level.name()
    if state.pending_transition and state.level_name then
        local raid_level = z_raid_item_travel_dungeons and z_raid_item_travel_dungeons.level_name_dunge
        local raid_type = z_raid_item_travel_dungeons and z_raid_item_travel_dungeons.type_dungeon
        local same_level = state.level_name == current_level
        local raid_matches = (not raid_level or raid_level == current_level)
            and (not raid_type or raid_type == state.sortie_type)
        if same_level and raid_matches then
            log("transition resolved same_level=%s sortie=%s; preserving zones=%s",
                tostring(current_level), tostring(state.sortie_type), tostring(size_table(state.zones or {})))
            state.pending_transition = false
            state.transition_from_level = nil
        else
            cleanup("confirmed_level_change")
        end
    elseif state.level_name and state.level_name ~= current_level then
        cleanup("loaded_other_level")
    end
    if state.level_name == level.name() then
        for _, zone in pairs(state.zones) do
            if not zone.closed then refresh_zone_spots(zone) end
        end
        release_log("runtime initialized type=%s restored_zones=%s",
            tostring(state.sortie_type), tostring(size_table(state.zones or {})))
    end
end

local function actor_on_update()
    if not enabled() or not db.actor then return end
    local now = time_global()
    if now < next_update then return end
    next_update = now + math.max(250, C.get_number("global", "update_interval_ms", 1000))

    if C.get_bool("global", "debug_cleanup_current_sortie", false) then cleanup("debug_flag"); return end
    if not state.level_name or state.level_name ~= level.name() then return end
    if not state.start_pos and state.start_capture_after and now >= state.start_capture_after then
        state.start_pos = pos_table(db.actor:position())
        log("start position captured (%s, %s, %s)", fmt_number(state.start_pos.x), fmt_number(state.start_pos.y), fmt_number(state.start_pos.z))
    end
    detect_rvm_squad_changes()
    if state.need_scouting_stash and state.start_pos then
        state.need_scouting_stash = nil
        create_scouting_stash()
    end
    if state.sortie_type == "infected" then
        for key, artifact_id in pairs(state.pending_artifacts) do
            if create_artifact_zone(artifact_id) then state.pending_artifacts[key] = nil end
        end
        if not state.decoys_created and state.last_artifact_time > 0 and now - state.last_artifact_time >= 2000 then create_decoys() end
        update_zones(now)
    end
end

local function on_before_level_changing()
    if state.level_name then
        state.pending_transition = true
        state.transition_from_level = level and level.name() or state.level_name
        log("transition pending from=%s zones=%s; cleanup deferred until next level",
            tostring(state.transition_from_level), tostring(size_table(state.zones or {})))
    end
    debug_override = nil
end

local function save_state(m_data)
    m_data.rvm_sorties_rework = state
end

local function load_state(m_data)
    state = m_data.rvm_sorties_rework or fresh_state()
    reported_artifact_overlaps = {}
    state.zones = state.zones or {}
    state.artifact_zone = state.artifact_zone or {}
    state.pending_artifacts = state.pending_artifacts or {}
    state.stash_ids = state.stash_ids or {}
    state.counters = state.counters or fresh_state().counters
    state.census_squads = state.census_squads or {}
    state.census_initialized = state.census_initialized or false
    state.pending_transition = state.pending_transition == true
    state.transition_from_level = state.transition_from_level or nil
    for _, zone in pairs(state.zones) do
        if zone.kind == "enemy" then
            zone.member_ids = zone.member_ids or zone.spawned_ids or {}
            zone.spawned_ids = zone.member_ids
            zone.spawned_info = zone.spawned_info or {}
            -- time_global is process-local and cached ALife anomaly data may
            -- have changed across load. Allow one fresh, safe attempt.
            zone.ambush_retry_at = 0
            zone.ambush_retry_actor_pos = nil
            zone.ambush_retry_view_dir = nil
            zone.anomaly_positions = nil
            zone.anomaly_scan_complete = nil
        end
    end
    state.schema = 3
end

local function find_debug_ui(...)
    local values = { ... }
    for _, value in ipairs(values) do
        if type(value) == "table" or type(value) == "userdata" then
            local ok, method = pcall(function() return value.SendOutput end)
            if ok and type(method) == "function" then return value, method end
        end
    end
    return nil, nil
end

local function debug_output(ui, method, text)
    local delivered = false
    if ui and method then delivered = pcall(method, ui, text) end
    printf(PREFIX .. " %s", tostring(text))
    return delivered
end

local function set_debug_mode(mode, ...)
    local ui, method = find_debug_ui(...)
    if mode == "auto" then debug_override = nil
    elseif mode == "on" or mode == "off" then debug_override = mode
    else return false end
    refresh_all_zone_spots()
    local message = "runtime debug mode=" .. tostring(mode)
        .. " effective=" .. tostring(debug_enabled())
        .. " DEV_DEBUG=" .. tostring(DEV_DEBUG)
        .. " DEV_DEBUG_DEV=" .. tostring(DEV_DEBUG_DEV)
    debug_output(ui, method, message)
    if debug_enabled() then
        state.census_initialized = false
        detect_rvm_squad_changes()
    end
    return true
end

local function debug_command(...)
    local ui, method = find_debug_ui(...)
    local values = { ... }
    local text = ""
    for _, value in ipairs(values) do
        if type(value) == "table" and value ~= ui then
            for _, nested in pairs(value) do
                if type(nested) == "string" or type(nested) == "number" then
                    text = text .. " " .. tostring(nested)
                end
            end
        elseif type(value) == "string" or type(value) == "number" then
            text = text .. " " .. tostring(value)
        end
    end
    text = string.lower(text)
    local mode = string.match(text, "%f[%a](auto)%f[%A]")
        or string.match(text, "%f[%a](on)%f[%A]")
        or string.match(text, "%f[%a](off)%f[%A]")
    if not mode then
        debug_output(ui, method, "usage: rvm_rework_debug auto|on|off; or use rvm_rework_debug_auto/on/off")
        return
    end
    set_debug_mode(mode, ...)
end

local function census_command(...)
    local ui, method = find_debug_ui(...)
    local summary, err = population_census("console_command")
    if summary then
        debug_output(ui, method, "census squads=" .. tostring(summary.squads)
            .. " stalkers=" .. tostring(summary.stalkers)
            .. " mutants=" .. tostring(summary.mutants) .. " (details in xray log)")
    else
        debug_output(ui, method, "census unavailable: " .. tostring(err))
    end
end

local function register_debug_commands()
    if not (add_console_command and (DEV_DEBUG == true or DEV_DEBUG_DEV == true)) then return end
    add_console_command("rvm_rework_debug", debug_command)
    add_console_command("rvm_rework_debug_auto", function(...) set_debug_mode("auto", ...) end)
    add_console_command("rvm_rework_debug_on", function(...) set_debug_mode("on", ...) end)
    add_console_command("rvm_rework_debug_off", function(...) set_debug_mode("off", ...) end)
    add_console_command("rvm_rework_census", census_command)
end

function on_game_start()
    if callbacks_registered then return end
    callbacks_registered = true
    C.reload()
    install_hooks()
    register_debug_commands()
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
    RegisterScriptCallback("actor_on_update", actor_on_update)
    RegisterScriptCallback("actor_on_item_take", actor_on_item_take)
    RegisterScriptCallback("npc_on_item_take", npc_on_item_take)
    RegisterScriptCallback("physic_object_on_use_callback", physic_object_on_use_callback)
    RegisterScriptCallback("on_before_level_changing", on_before_level_changing)
    RegisterScriptCallback("save_state", save_state)
    RegisterScriptCallback("load_state", load_state)
end
