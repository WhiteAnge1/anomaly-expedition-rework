enemy_spawn_distance_max = 150

; Тёмная лощина — фактический идентификатор k01_darkscape, тир 2.
[level_k01_darkscape]
; Локальные значения перекрывают tier_2 и global.
; При изменении также проверь: proximity camera-check и hidden-ступени.
