tier_2_weight_medium = 43
tier_2_weight_high = 15
tier_2_weight_unique = 0

tier_3_weight_junk = 2
tier_3_weight_low = 8
tier_3_weight_medium = 43
tier_3_weight_high = 45
tier_3_weight_unique = 2

