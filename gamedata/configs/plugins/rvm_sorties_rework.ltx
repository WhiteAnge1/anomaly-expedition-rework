; ============================================================================
; Anomaly Expedition Rework by White_Angel 0.3.0-rc9
; Все расстояния указаны в игровых метрах, вероятности и веса — числа >= 0.
; Иерархия значений: [global] -> [tier_N] -> [level_техническое_имя].
; После изменения файла полностью перезапустите игру.
; ============================================================================

[global]
; Основной выключатель. false: callbacks остаются безопасными, но ничего не создают.
enabled = true

; true uses the per-location artifact_count_* tables below. false preserves
; the stock RVM artifact count for every supported infected expedition.
enable_location_artifact_counts = true
; true uses each level's zone_count_* table for false search areas. false uses
; the global fallback directly below. These counts never change true fields.
enable_location_zone_counts = true
zone_count_values = 1
zone_count_weights = 1

; Тайники: anomaly (исходное поведение), scouting (перенос), disabled (отключить).
stash_mode = scouting

; Независимые дополнительные типы ложных областей.
; Связано с: weight_enemy/weight_loot/weight_empty и debug_force_decoy_type.
; При изменении также проверь: что хотя бы один включённый тип имеет вес больше нуля.
enable_enemy_decoys = true
enable_loot_decoys = true
enable_empty_decoys = true

; Относительные веса ложных областей: 50% опасная, 25% добыча, 25% пустая.
; После отключения типов оставшиеся веса автоматически нормализуются.
; Связано с: enable_*_decoys; это веса выбора, а не количество областей.
weight_enemy = 50
weight_loot = 25
weight_empty = 25

; Видимые модели контейнеров используют штатную систему малых тайников сборки.
loot_container_visuals = raid_small_stash_1, raid_small_stash_2, raid_small_stash_3, raid_small_stash_4, raid_small_stash_5, raid_small_stash_6, raid_small_stash_7, raid_small_stash_8, raid_small_stash_9, raid_small_stash_10, raid_small_stash_11, raid_small_stash_12, raid_small_stash_13, raid_small_stash_14, raid_small_stash_15, raid_small_stash_16, raid_small_stash_17

; При true метка исчезает, если callback сообщил о подборе артефакта NPC.
; По умолчанию false, чтобы не раскрывать игроку кражу артефакта.
; Связано с: show_exact_artifact_markers и жизненным циклом настоящей области.
remove_on_npc_pickup = false

; Fallback смещения центра настоящей области: доля её радиуса (0.0-1.0).
; Точные принятые значения задаются ниже по тирам и могут быть переопределены
; в секции конкретного уровня благодаря иерархии global -> tier -> level.
; Связано с: zone_radius_min/max и placement_attempts.
; При изменении также проверь: что точный артефакт остаётся внутри круга после nav-привязки.
artifact_offset_fraction_min = 0.35
artifact_offset_fraction_max = 0.80
; Максимальное смещение центра loot-области от контейнера: radius / divisor.
; Связано с: zone_radius_min/max; больше divisor — контейнер ближе к центру круга.
loot_offset_divisor = 3

; Минимальное расстояние между центрами областей и число попыток размещения.
; Связано с: всеми ложными областями; настоящие artifact-области могут перекрываться.
; При изменении также проверь: частоту exhausted/error на всех трёх локациях.
zone_separation_min = 45
placement_attempts = 60
; Скрытые proximity-ступени используют расширенный low-discrepancy nav-поиск.
; Связано с: placement_attempts и ambush_spawn_timing=proximity.
ambush_hidden_attempt_multiplier = 3

; Радиус запрета опасной области вокруг фактической стартовой позиции игрока.
; Связано с: ambush_trigger_padding и ambush_start_trigger_margin.
ambush_start_exclusion_radius = 180
; Для start-засад центр области сначала ищется не ближе этого расстояния.
; Если геометрия уровня не позволяет, поиск ослабляется до enemy_spawn_distance_min.
; При изменении также проверь: level_y04_pole, level_l09_deadcity и стартовую позицию.
ambush_start_center_exclusion_radius = 120
; Запас между стартовой позицией и фактическим порогом активации опасной области.
ambush_start_trigger_margin = 20
; Засада активируется заранее; фактический порог = радиус области + это значение.
; Связано с: zone_radius_min/max, ambush_start_trigger_margin и spawn timing.
ambush_trigger_padding = 130
; Запас сверх штатного радиуса доспавна РВМ.
ambush_extra_padding = 20
; proximity: при приближении с проверкой камеры; start: при создании зоны без camera-check.
; При изменении также проверь: локальные ambush_spawn_timing и каскад safe/hidden ступеней.
ambush_spawn_timing = proximity
; Отступ от известных аномалий на строгой первой ступени каскада.
ambush_anomaly_clearance = 15
; Внутренние ступени каскада держат точку на таком расстоянии от края области.
ambush_start_zone_margin = 8
; Аварийные ступени могут поставить отряд в этом поясе сразу за границей круга.
ambush_outside_zone_padding = 25
; Если размер формы аномалии безопасно прочитать нельзя, используется этот радиус.
ambush_unknown_anomaly_radius = 20
; Не удалять область при временном отсутствии безопасной точки: повторить поиск позже.
; Связано с: update_interval_ms; фактическая задержка не может быть короче update tick.
ambush_retry_delay_ms = 10000
; Резерв, если таблица РВМ недоступна.
; Связано с: enemy_spawn_distance_min/max и штатным радиусом доспавна РВМ.
ambush_spawn_safe_fallback = 85
; Расстояние точки появления от центра области.
; При изменении также проверь: локальные overrides, ambush_start_zone_margin и ambush_outside_zone_padding.
enemy_spawn_distance_min = 35
enemy_spawn_distance_max = 90
; Сначала выбирается категория по относительным весам, затем один из её
; точных squad-пресетов равновероятно. Ноль отключает категорию.
; Связано с: gamedata/configs/mod_system_rvm_sorties_squads.ltx.
enemy_category_weight_frequent = 4
enemy_category_weight_rare = 2
enemy_category_weight_superrare = 1
; Если созданные существа исчезли из A-Life, область считается разрешённой.
enemy_missing_resolves = true

; Обычный этап всегда делает хотя бы один бросок. Повторы разрешены.
; Связано с: loot_fragments, tier loot_*_weight, quantity_min/max и loot_cap.
loot_ordinary = flashlight_broken, itm_sleepbag, gloves, ecolog_patch, csky_patch, headlamp, walkie, broken_detector, compression_bag, bolt, bolts_pack, hand_watch, item_raid_art_fragment_gravi, item_raid_art_fragment_electro, item_raid_art_fragment_chem, item_raid_art_fragment_thermo
loot_fragments = item_raid_art_fragment_gravi, item_raid_art_fragment_electro, item_raid_art_fragment_chem, item_raid_art_fragment_thermo
; Цепочка квоты дорогих предметов: 35% хотя бы один, затем 10% второй,
; затем 1.5% третий. Повторы запрещены, кроме lead_box на тире 3.
; Связано с: tier loot_valuable и loot_cap; rare_slot считается отдельно сверх cap.
valuable_first_chance = 35
valuable_second_chance = 10
valuable_third_chance = 1.5
rare_slot_chance = 4
; Если редкий слот сработал, шанс выбрать артефакт вместо прочей редкой награды.
; Пул берётся из фактической таблицы raid_artefacts_tiers_by_dop текущей сборки:
; T1 Поляна = весь мусор + T1; T2 Лощина = T1 + T2; T3 Мёртвый город = T2 + T3.
; При изменении также проверь: loot_rare_non_artifact каждого тира и очередь raid_artefacts.
rare_artifact_chance = 70

; Период обновления логики, мс. Допустимо 250-5000; по умолчанию 1000.
update_interval_ms = 1000

; --------------------------------------------------------------------------
; Все новые артефакты infected-вылазки создаются над доказанной static-ray
; поверхностью и фиксируются с первого доступного binder lifecycle callback до
; подбора. Это намеренно отключает их штатное качение/левитацию ради доступности.
artifact_proactive_hold = true
; Schema 7 correction: clearance below is SERVER-SPAWN clearance only. X-Ray
; normalizes the online artifact pivot back to the proven static surface; the
; schema 9 waits for a ready physics shell, lifts the exact client object to the
; configured visible hover, verifies it, then fixes the shell in one callback.
; Высота pivot над static-ray surface, допустимый диапазон 0.5-1.0 м. Default
; 0.75 м намеренно оставляет небольшую видимую левитацию даже на склоне.
; Не прибавляется к произвольной server position: target обязан заранее пройти
; vertex, ray и captured-field guards.
artifact_proactive_clearance = 0.75
; Direct client-object lift before physics fix. This is intentionally visible:
; some artifact meshes were unpickable when fixed at surface_y-0.1..-0.3.
; Runtime range: 0.5..3.0 m. Does not call alife():teleport_object or respawn.
artifact_online_hold_clearance = 1.0
; Допуск только для проверки свежей client shell. Он не разрешает relocation:
; proactive path никогда не вызывает teleport_object для online объекта.
artifact_proactive_position_tolerance = 0.35

; Ниже оставлен диагностический legacy rescue для старых alpha-save. Новые
; schema-9 records его полностью обходят; legacy без доказанного target работает
; observe-only и не выполняет рискованные действия.
artifact_rescue_observe_only = false
; Schema 9 supersedes the older schema-6 description above: exact guarded
; targets persist spawn, surface and raised online-hold coordinates separately.
; Общий предохранитель только legacy/debug действий.
artifact_rescue_actions = false
; Production policy: held_first. После штатных 15 секунд подтверждённого rolling
; первый rescue делает same-ID teleport, три fresh snapshots, reacquire и held.
; Значение debug_teleport возвращает закрытый exact-ID лабораторный сценарий.
artifact_rescue_rolling_policy = held_first
; Отдельная production policy только для настоящего vertical underground.
; Она использует captured field provenance и не меняет rolling/origin priority.
artifact_rescue_underground_policy = held_first
; Отдельная production policy для строго доказанного world-origin mismatch.
; Требует captured field provenance, initial+current near-origin, удалённое поле,
; плохой nav/vertex, прежний ID/section/level и static-ray target.
artifact_rescue_origin_policy = held_first
; Штатный RVM-генератор повторно выбирает внутреннюю позицию, пока она не
; пройдёт valid vertex + static-ray + captured-field guards. При исчерпании
; объект не создаётся, а ошибка явно пишется в журнал.
artifact_spawn_guard_attempts = 8
; Узкий laboratory fallback при artifact_rescue_rolling_policy=debug_teleport:
; same-ID teleport только для exact original IDs 1407 и 6362 и причины rolling.
; Section fallback запрещён.
; После position_verified каждый ID независимо наблюдается минимум 30 секунд;
; повторный непрерывный выход radius+5 на 15 секунд допускает второй dispatch
; только после cooldown 20 секунд. Максимум две отправки на каждый ID.
; Отдельный экспериментальный gate ниже разрешает ровно третий dispatch только
; после двух verified обычных отправок и нового подтверждённого rolling-эпизода.
; Он пробует same-callback physics fix/release; permanent fix запрещён.
; Observe/actions/same-ID gate остаются обязательными зависимостями.
; Никогда не оставлять включённым после полевого эксперимента.
artifact_rescue_debug_same_id_teleport = false
artifact_rescue_debug_artifact_ids = 1407,6362
artifact_rescue_debug_reason = rolling
artifact_rescue_debug_monitor_ms = 30000
artifact_rescue_debug_monitor_log_ms = 5000
artifact_rescue_debug_cooldown_ms = 20000
artifact_rescue_debug_max_dispatches = 2
artifact_rescue_debug_same_frame_stabilization = false
; Только для policy=debug_teleport: диагностический порог verified rescue до held.
artifact_rescue_debug_held_after_verified_actions = 2
; Альтернативный, несовместимый с same-frame gate эксперимент: третий dispatch
; фиксирует заново полученные элементы только после post-teleport position_verified
; и держит их до pickup, выключения gate, pre-save, level-change/cleanup либо timeout.
; held_timeout_ms = 0 отключает только автоматический time release. Оба stabilization
; gate одновременно дают fail-closed conflict и не разрешают третий dispatch.
artifact_rescue_debug_held_stabilization = false
artifact_rescue_debug_held_timeout_ms = 120000
; Строгий origin-кандидат требует одновременно близость к нулю, несовпадение с
; реальным полем, плохой vertex, отсутствие владельца и проверенную static-цель.
artifact_rescue_origin_radius = 2
artifact_rescue_origin_field_margin = 2
artifact_rescue_origin_nav_mismatch = 4
; Underground считается подтверждённым только при падении >=12 м, vertex выше
; минимум на 4 м (либо invalid) и трёх samples минимум за две секунды.
artifact_rescue_underground_drop = 12
artifact_rescue_underground_vertex_gap = 4
artifact_rescue_underground_samples = 3
artifact_rescue_underground_duration_ms = 2000
; Rolling-эпизод начинается за linked radius + 5 м. Возврат внутрь до 15 секунд
; сбрасывает его; устойчивое превышение только помечается rescue_pending.
artifact_rescue_rolling_edge_margin = 5
artifact_rescue_rolling_confirm_ms = 15000
; Повторные save/сводные сообщения не чаще этого интервала.
artifact_rescue_log_repeat_ms = 60000

; --------------------------------------------------------------------------
; Необязательный казуальный режим точных меток. По умолчанию всё выключено:
; обычный баланс реворка — приблизительные области и самостоятельный поиск.
; true включает только выбранную метку, без debug-подписей, ID, координат,
; журнала и census. После изменения полностью перезапустите игру.
; Связано с: debug_mode; полный debug принудительно показывает все exact-метки.
; Зелёная точная метка связанного рейдового артефакта.
show_exact_artifact_markers = false
; Красная точная stash-метка контейнера ложной области.
show_exact_loot_markers = false
; Красные точки только живых врагов, созданных опасной областью этого мода.
show_exact_enemy_markers = false

; Диагностика: auto следует глобальным DEV_DEBUG/DEV_DEBUG_DEV, on/off задают
; явное поведение. Публичный default не включает debug без debug-запуска игры.
debug_mode = off
; Совместимость со старыми конфигами: используется только если debug_mode отсутствует.
debug_log = false
; off, artifact, enemy, loot, empty — принудительный тип ложных областей для теста.
; Связано с: enable_*_decoys и weight_* только при off; forced-режим их обходит.
debug_force_decoy_type = off
; 0 — фактический тир; 1/2/3 — принудительная таблица для теста.
; При изменении также проверь: tier map_spot, радиусы, loot и enemy-профили.
debug_force_tier = 0
; true очищает состояние при следующем обновлении. Затем верните false вручную.
debug_cleanup_current_sortie = false

[artifact_pool]
; Профиль настоящих артефактов в anomaly-fields infected-вылазок.
; weighted (рекомендуется): семейство зоны остаётся штатным, затем отдельно
; выбирается качество по весам тира и равновероятная base-section внутри
; полного семейного каталога АЭР. stock: исходные короткие списки GRA Bolt.
; Ошибка таблиц, весов или hook автоматически и целиком возвращает stock.
profile = weighted

; Каждый ряд обязан состоять из целых неотрицательных весов с суммой 100.
; Порядок категорий: junk / low / medium / high / unique.
tier_1_weight_junk = 45
tier_1_weight_low = 45
tier_1_weight_medium = 10
tier_1_weight_high = 0
tier_1_weight_unique = 0

tier_2_weight_junk = 10
