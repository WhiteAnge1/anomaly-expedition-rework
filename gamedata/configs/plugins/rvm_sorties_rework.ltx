loot_medicine = medkit_scientic, medkit_army, antirad, stimpack_scientic
loot_utility = detector_elite, detector_scientific, itm_ammokit, simk_card
loot_modules = af_iam, af_aac, af_aam, lead_box, artifact_container
loot_rare_non_artifact = raid_intelligence_note

